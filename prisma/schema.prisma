  receiverName      String?                  @db.VarChar(160)
  deliveryFee       Decimal                  @default(0) @db.Decimal(12, 2)
  notes             String?                  @db.Text
  createdAt         DateTime                 @default(now())
  createdById       Int?
  reversedAt        DateTime?
  reversedById      Int?
  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order             CustomerOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  branch            Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer          LoyaltyCustomer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  driver            User?                    @relation("DeliveryDriver", fields: [driverId], references: [id], onDelete: SetNull)
  driverProfile     DriverProfile?           @relation(fields: [driverProfileId], references: [id], onDelete: SetNull)
  createdBy         User?                    @relation("OrderDeliveryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reversedBy        User?                    @relation("OrderDeliveryReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)
  items             OrderDeliveryItem[]
  payments          CustomerPayment[]
  positions         DriverPosition[]
  incidents         DriverIncident[]
  statusLogs        OrderDeliveryStatusLog[]

  @@unique([tenantId, number])
  @@index([tenantId, orderId, createdAt])
  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, branchId, status, createdAt])
  @@index([tenantId, driverId, status])
  @@index([tenantId, driverProfileId, status])
  @@index([tenantId, provider, externalOrderId])
