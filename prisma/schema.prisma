/**
 * @summary Remito/entrega histórica e inmutable generada a partir de un pedido.
 * Cada entrega registra las cantidades efectivamente despachadas y sirve como
 * documento de referencia para cobros y auditoría.
 */
model OrderDelivery {
  id                Int                      @id @default(autoincrement())
  tenantId          Int
  orderId           Int
  number            String                   @db.VarChar(24)
  deliveryDate      DateTime                 @default(now())
  branchId          Int?
  customerId        Int?
  customerName      String                   @db.VarChar(160)
  deliveryAddress   String?                  @db.VarChar(500)
  deliveryType      String                   @default("full") @db.VarChar(20)
  status            String                   @default("delivered") @db.VarChar(24)
  provider          DeliveryProvider         @default(MENUCLICK)
  externalOrderId   String?                  @db.VarChar(120)
  externalReference String?                  @db.VarChar(200)
  driverId          Int?
  driverProfileId   Int?
  assignedAt        DateTime?
  pickedUpAt        DateTime?
  deliveredAt       DateTime?
  latitude          String?                  @db.VarChar(32)
  longitude         String?                  @db.VarChar(32)
  addressSnapshot   String?                  @db.VarChar(500)
  contactPhone      String?                  @db.VarChar(60)
  contactName       String?                  @db.VarChar(160)
