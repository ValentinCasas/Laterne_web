  membershipId Int
  branchId     Int
  createdAt    DateTime         @default(now())
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([membershipId, branchId])
  @@index([branchId])
  @@map("branchmembership")
}

model InventoryStock {
  id        Int             @id @default(autoincrement())
  tenantId  Int
  branchId  Int
  productId Int
  tracked   Boolean         @default(false)
  current   Decimal         @default(0) @db.Decimal(12, 3)
  /** Unidades comprometidas (reservas): el disponible es `current - reserved`. */
  reserved  Decimal         @default(0) @db.Decimal(12, 3)
  minimum   Decimal         @default(0) @db.Decimal(12, 3)
  unit      String          @default("unidad") @db.VarChar(40)
  updatedAt DateTime        @updatedAt
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements StockMovement[]
  countItems InventoryCountItem[]

  @@unique([branchId, productId])
  @@index([tenantId, tracked, current])
  @@map("inventorystock")
}

model StockMovement {
  id           BigInt         @id @default(autoincrement())
  tenantId     Int
  stockId      Int
  orderId      Int?
  transferId   Int?
  userId       Int?
  type         String         @db.VarChar(30)
  quantity     Decimal        @db.Decimal(12, 3)
  balanceAfter Decimal        @db.Decimal(12, 3)
  /** Costo unitario en el momento del movimiento: snapshot que nunca se reescribe. */
  unitCost     Decimal?       @db.Decimal(14, 4)
  /** Saldo reservado tras un movimiento de reserva/liberación (null si no aplica). */
  reservedAfter Decimal?     @db.Decimal(12, 3)
  /** Referencia legible del documento origen (pedido, transferencia, conteo, merma). */
  reference    String?        @db.VarChar(80)
  reason       String         @db.VarChar(300)
  createdAt    DateTime       @default(now())
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stock        InventoryStock @relation(fields: [stockId], references: [id], onDelete: Cascade)
  order        CustomerOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  transfer     StockTransfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([stockId, createdAt])
  @@index([orderId])
  @@index([transferId])
  @@index([tenantId, type, createdAt])
  @@map("stockmovement")
}

/**
 * @summary Configuración de inventario por negocio (política de venta sin stock).
 * `strict` impide vender sin stock disponible; `warn` permite vender y registra
 * stock negativo con advertencia.
 */
model InventorySettings {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @unique
  stockPolicy String   @default("strict") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("inventorysettings")
}

/**
 * @summary Transferencia de stock entre sucursales del mismo negocio.
 * La salida del origen y la entrada del destino son atómicas (misma transacción)
 * y quedan trazadas con movimientos `transfer_out` / `transfer_in`.
 */
model StockTransfer {
  id           Int             @id @default(autoincrement())
  tenantId     Int
  reference    String          @db.VarChar(24)
  fromBranchId Int
  toBranchId   Int
  productId    Int
  quantity     Decimal         @db.Decimal(12, 3)
  unit         String          @default("unidad") @db.VarChar(40)
  status       String          @default("completed") @db.VarChar(20)
  note         String?         @db.VarChar(300)
  createdById  Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromBranch   Branch          @relation("TransferFrom", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranch     Branch          @relation("TransferTo", fields: [toBranchId], references: [id], onDelete: Restrict)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy    User?           @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  movements    StockMovement[]

  @@unique([tenantId, reference])
  @@index([tenantId, fromBranchId, createdAt])
  @@index([tenantId, toBranchId, createdAt])
  @@map("stocktransfer")
}

/**
 * @summary Sesión de conteo físico de inventario de una sucursal.
 * Captura la cantidad de sistema al abrir; al completar, la diferencia se
 * ajusta con movimientos `count_adjustment` y queda registrado quién y cuándo.
 */
model InventoryCountSession {
  id            Int                  @id @default(autoincrement())
  tenantId      Int
  branchId      Int
  reference     String               @db.VarChar(24)
  status        String               @default("open") @db.VarChar(20)
  note          String?              @db.VarChar(300)
  startedById   Int?
  completedById Int?
  startedAt     DateTime             @default(now())
  completedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  startedBy     User?                @relation("CountStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  completedBy   User?                @relation("CountCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  items         InventoryCountItem[]

  @@unique([tenantId, reference])
  @@index([tenantId, branchId, status, startedAt])
  @@map("inventorycountsession")
}

/**
 * @summary Línea de un conteo físico: cantidad de sistema vs contada y su diferencia.
 */
model InventoryCountItem {
  id              Int                   @id @default(autoincrement())
  sessionId       Int
  stockId         Int?
  productId       Int
  systemQuantity  Decimal               @db.Decimal(12, 3)
  countedQuantity Decimal               @db.Decimal(12, 3)
  difference      Decimal               @default(0) @db.Decimal(12, 3)
  adjusted        Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  session         InventoryCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stock           InventoryStock?       @relation(fields: [stockId], references: [id], onDelete: SetNull)
  product         Product               @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([sessionId, productId])
  @@index([sessionId])
  @@map("inventorycountitem")
}

model InvoiceRecord {
  id            Int                      @id @default(autoincrement())
  tenantId      Int
  branchId      Int?
  orderId       Int                      @unique
  status        String                   @default("draft") @db.VarChar(24)
  documentType  String                   @default("internal_receipt") @db.VarChar(40)
  number        String?                  @db.VarChar(80)
  customerName  String                   @db.VarChar(180)
  customerTaxId String?                  @db.VarChar(40)
  subtotal      Decimal                  @db.Decimal(12, 2)
  tax           Decimal                  @default(0) @db.Decimal(12, 2)
  total         Decimal                  @db.Decimal(12, 2)
  currency      String                   @default("ARS") @db.VarChar(3)
  externalId    String?                  @db.VarChar(180)
  notes         String?                  @db.Text
  issuedAt      DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  order         CustomerOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  document      InvoiceDocumentArtifact?

  @@index([tenantId, status, createdAt])
  @@index([tenantId, number])
  @@map("invoicerecord")
}

/**
 * @summary Versión inmutable de una plantilla Word cargada por un tenant.
 */
model DocumentTemplate {
  id               Int                       @id @default(autoincrement())
  tenantId         Int
  documentType     String                    @default("internal_receipt") @db.VarChar(40)
  name             String                    @db.VarChar(160)
  originalFilename String                    @db.VarChar(255)
  mimeType         String                    @db.VarChar(120)
  sizeBytes        Int
  checksum         String                    @db.Char(64)
  content          Bytes                     @db.LongBlob
  version          Int                       @default(1)
  active           Boolean                   @default(false)
  isDefault        Boolean                   @default(false)
  deletedAt        DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents        InvoiceDocumentArtifact[]

  @@unique([tenantId, documentType, version])
  @@unique([tenantId, documentType, checksum])
  @@index([tenantId, documentType, active, deletedAt])
  @@map("documenttemplate")
}

/**
 * @summary Snapshot DOCX/PDF de un comprobante para no alterar documentos históricos al cambiar plantillas.
 */
model InvoiceDocumentArtifact {
  id                Int               @id @default(autoincrement())
  tenantId          Int
  invoiceId         Int               @unique
  templateId        Int?
  templateVersion   Int?
  docx              Bytes             @db.LongBlob
  pdf               Bytes?            @db.LongBlob
  pdfStatus         String            @default("unavailable") @db.VarChar(24)
  converter         String?           @db.VarChar(80)
  conversionMessage String?           @db.VarChar(500)
  createdAt         DateTime          @default(now())
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice           InvoiceRecord     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  template          DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([templateId])
  @@map("invoicedocumentartifact")
}

model InvoiceSettings {
  id             Int      @id @default(autoincrement())
  tenantId       Int      @unique
  issuerName     String?  @db.VarChar(180)
  taxId          String?  @db.VarChar(40)
  address        String?  @db.VarChar(300)
  city           String?  @db.VarChar(120)
  terms          String?  @db.Text
  templatePreset String   @default("classic") @db.VarChar(30)
  design         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("invoicesettings")
}

model IntegrationSettings {
  id               Int       @id @default(autoincrement())
  tenantId         Int
  provider         String    @db.VarChar(60)
  enabled          Boolean   @default(false)
  mode             String    @default("disabled") @db.VarChar(20)
  publicConfig     Json?
  secretConfigured Boolean   @default(false)
  status           String    @default("not_configured") @db.VarChar(30)
  lastCheckAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId, enabled, status])
  @@map("integrationsettings")
}

model SeoPage {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  path        String   @db.VarChar(220)
  title       String   @db.VarChar(180)
  description String   @db.VarChar(500)
  canonical   String?  @db.VarChar(500)
  ogImageUrl  String?  @db.VarChar(500)
  noIndex     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, path])
  @@map("seopage")
}

model RedirectRule {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  sourcePath String   @db.VarChar(300)
  targetPath String   @db.VarChar(500)
  permanent  Boolean  @default(true)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourcePath])
  @@index([tenantId, active])
  @@map("redirectrule")
}

model ErrorLog {
  id          BigInt    @id @default(autoincrement())
  tenantId    Int?
  level       String    @default("error") @db.VarChar(20)
  source      String    @db.VarChar(80)
  message     String    @db.VarChar(1000)
  path        String?   @db.VarChar(500)
  fingerprint String?   @db.VarChar(64)
  context     Json?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, resolvedAt, createdAt])
  @@index([fingerprint, createdAt])
  @@map("errorlog")
}

model PasswordResetRequest {
  id          Int       @id @default(autoincrement())
  tenantId    Int?
  userId      Int?
  emailHash   String    @db.VarChar(64)
  tokenHash   String?   @db.VarChar(64)
  status      String    @default("requested") @db.VarChar(24)
  requestedIp String?   @db.VarChar(64)
  expiresAt   DateTime?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([emailHash, createdAt])
  @@index([tokenHash])
  @@map("passwordresetrequest")
}

model PlatformPayment {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  period      String   @db.VarChar(7)
  paidAt      DateTime
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @default("ARS") @db.VarChar(3)
  method      String   @db.VarChar(40)
  reference   String?  @db.VarChar(120)
  note        String?  @db.Text
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("PlatformPaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, paidAt])
  @@index([tenantId, period])
  @@index([createdById])
  @@map("platformpayment")
}
