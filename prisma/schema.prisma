generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/**
 * @summary Estados comerciales que atraviesa la suscripción de un cliente de MenuClick.
 */
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAYMENT_PENDING
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

/**
 * @summary Canal comercial del pedido: cómo se generó la venta.
 */
enum OrderChannel {
  SALON
  MOSTRADOR
  DELIVERY
  ONLINE
}

/**
 * @summary Origen técnico del pedido: quién/qué lo generó.
 */
enum OrderSource {
  ADMIN
  MENUCLICK_WEB
  TABLE_QR
  POS
  EXTERNAL_INTEGRATOR
  API
}

/**
 * @summary Estados específicos del ciclo de entrega/reparto.
 */
enum DeliveryStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  FAILED
  CANCELLED
}

/**
 * @summary Proveedor externo de delivery o integrador.
 */
enum DeliveryProvider {
  MENUCLICK
  RAPPI
  PEDIDOS_YA
  UBER_EATS
  CUSTOM
}

/**
 * @summary Tipos de eventos externos para webhooks/integradores.
 */
enum ExternalEventType {
  ORDER_CREATED
  ORDER_UPDATED
  ORDER_CANCELLED
  DRIVER_ASSIGNED
  DELIVERY_UPDATED
}

model BusinessInfo {
  id           Int     @id @default(autoincrement())
  tenantId     Int     @unique
  latitude     String? @db.VarChar(255)
  longitude    String? @db.VarChar(255)
  address      String? @db.VarChar(255)
  email        String? @db.VarChar(255)
  phoneNumber  BigInt?
  instagramUrl String? @db.VarChar(255)
  facebookUrl  String? @db.VarChar(255)
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("businessinfo")
}

model Category {
  id          Int                 @id @default(autoincrement())
  tenantId    Int
  branchId    Int?
  parentId    Int?
  name        String              @db.VarChar(255)
  slug        String              @db.VarChar(180)
  description String              @db.VarChar(255)
  imageUrl    String              @db.VarChar(255)
  status      String              @default("published") @db.VarChar(20)
  publishAt   DateTime?
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  parent      Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]          @relation("CategoryTree")
  products    ProductCategory[]
  promotions  PromotionCategory[]
  printAreas  PrintAreaCategory[]

  @@unique([tenantId, slug])
  @@index([tenantId, branchId, status, sortOrder])
  @@index([tenantId, parentId])
  @@map("category")
}

model Event {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  branchId    Int?
  name        String    @db.VarChar(255)
  date        DateTime? @db.DateTime(0)
  time        DateTime? @db.Time(0)
  description String    @db.VarChar(255)
  location    String    @db.VarChar(255)
  imageUrl    String?   @db.VarChar(255)
  status      String    @default("published") @db.VarChar(20)
  publishAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, status, date])
  @@map("event")
}

model OpeningHour {
  id               Int       @id @default(autoincrement())
  tenantId         Int
  branchId         Int?
  dayOfWeek        String    @db.VarChar(255)
  morningStartTime DateTime? @db.Time(0)
  morningEndTime   DateTime? @db.Time(0)
  eveningStartTime DateTime? @db.Time(0)
  eveningEndTime   DateTime? @db.Time(0)
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId])
  @@map("openinghour")
}

model Product {
  id                   Int                     @id @default(autoincrement())
  tenantId             Int
  name                 String                  @db.VarChar(255)
  slug                 String                  @db.VarChar(180)
  description          String                  @db.VarChar(700)
  availability         String?                 @map("availavility") @db.VarChar(255)
  price                Decimal?                @db.Decimal(10, 0)
  imageUrl             String                  @db.VarChar(255)
  status               String                  @default("published") @db.VarChar(20)
  publishAt            DateTime?
  featured             Boolean                 @default(false)
  isNew                Boolean                 @default(false)
  recommended          Boolean                 @default(false)
  vegetarian           Boolean                 @default(false)
  vegan                Boolean                 @default(false)
  glutenFree           Boolean                 @default(false)
  alcoholFree          Boolean                 @default(false)
  spiceLevel           Int                     @default(0)
  preparationMinutes   Int?
  promotionalPrice     Decimal?                @db.Decimal(10, 0)
  previousPrice        Decimal?                @db.Decimal(10, 0)
  model3dUrl           String?                 @db.VarChar(500)
  usdzUrl              String?                 @db.VarChar(500)
  modelPosterUrl       String?                 @db.VarChar(500)
  arEnabled            Boolean                 @default(false)
  arScale              Decimal                 @default(1.000) @db.Decimal(8, 3)
  modelWidthCm         Decimal?                @db.Decimal(8, 2)
  modelHeightCm        Decimal?                @db.Decimal(8, 2)
  modelDepthCm         Decimal?                @db.Decimal(8, 2)
  modelOrientation     String                  @default("0deg 0deg 0deg") @db.VarChar(80)
  arPlacement          String                  @default("floor") @db.VarChar(20)
  arAllowScale         Boolean                 @default(true)
  availableDays        Json?
  availableStartTime   DateTime?               @db.Time(0)
  availableEndTime     DateTime?               @db.Time(0)
  modelUpdatedAt       DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categories           ProductCategory[]
  allergens            ProductAllergen[]
  relatedFrom          ProductRelation[]       @relation("ProductRelationFrom")
  relatedTo            ProductRelation[]       @relation("ProductRelationTo")
  promotions           PromotionProduct[]
  variants             ProductVariant[]
  extras               ProductExtra[]
  optionGroups         ProductOptionGroup[]
  orderItems           OrderItem[]
  inventoryStocks      InventoryStock[]
  branchAssignments    BranchProduct[]
  station              KitchenStation?         @relation(fields: [stationId], references: [id], onDelete: SetNull)
  stationId            Int?
  printAreas           PrintAreaProduct[]
  cost                 Decimal?                @db.Decimal(12, 2)
  costUnit             String                  @default("unidad") @db.VarChar(40)
  favorite             Boolean                 @default(false)
  comboParts           ProductComboItem[]      @relation("ComboOwner")
  inCombos             ProductComboItem[]      @relation("ComboPart")
  recipeItems          RecipeIngredient[]      @relation("RecipeOwner")
  usedInRecipes        RecipeIngredient[]      @relation("RecipePart")
  priceLists           ProductPrice[]
  costHistory          IngredientCostHistory[]
  stockTransfers       StockTransfer[]
  countItems           InventoryCountItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseReceiptItems PurchaseReceiptItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  deliveryItems        OrderDeliveryItem[]

  @@unique([tenantId, slug])
  @@index([tenantId, status, featured])
  @@index([stationId])
  @@map("product")
}

model ProductCategory {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  productId  Int
  categoryId Int
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: NoAction, map: "productcategory_ibfk_1")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, map: "productcategory_ibfk_2")

  @@unique([productId, categoryId])
  @@index([categoryId], map: "categoryId")
  @@index([productId], map: "productId")
  @@index([tenantId])
  @@map("productcategory")
}

model Testimonial {
  id               Int      @id @default(autoincrement())
  tenantId         Int
  branchId         Int?
  description      String   @db.VarChar(255)
  state            Boolean
  moderationStatus String   @default("pending") @db.VarChar(20)
  date             DateTime @db.Date
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, moderationStatus])
  @@map("testimonial")
}

model User {
  id                       Int                      @id @default(autoincrement())
  name                     String                   @db.VarChar(255)
  email                    String                   @db.VarChar(255)
  password                 String                   @db.VarChar(255)
  role                     Int
  imageUrl                 String                   @db.VarChar(255)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  memberships              TenantMembership[]
  sessions                 AuthSession[]
  auditLogs                AuditLog[]
  assignedLeads            SalesLead[]              @relation("AssignedSalesLeads")
  isSuperAdmin             Boolean                  @default(false)
  platformRole             String?                  @db.VarChar(40)
  mediaAssets              MediaAsset[]
  platformPayments         PlatformPayment[]        @relation("PlatformPaymentCreatedBy")
  authHandoffs             AuthHandoff[]
  tableSessionsWaited      TableSession[]           @relation("WaiterTableSessions")
  tableSessionsClosed      TableSession[]           @relation("CloserTableSessions")
  tableSessionEvents       TableSessionEvent[]
  transfersCreated         StockTransfer[]          @relation("TransferCreatedBy")
  countSessionsStarted     InventoryCountSession[]  @relation("CountStartedBy")
  countSessionsCompleted   InventoryCountSession[]  @relation("CountCompletedBy")
  stockMovements           StockMovement[]
  purchaseOrdersCreated    PurchaseOrder[]          @relation("PurchaseOrderCreatedBy")
  purchaseReceiptsCreated  PurchaseReceipt[]        @relation("PurchaseReceiptCreatedBy")
  purchaseInvoicesCreated  PurchaseInvoice[]        @relation("PurchaseInvoiceCreatedBy")
  purchasePaymentsCreated  PurchasePayment[]        @relation("PurchasePaymentCreatedBy")
  expensesCreated          Expense[]                @relation("ExpenseCreatedBy")
  supplierLedgerEntries    SupplierLedgerEntry[]    @relation("SupplierLedgerCreatedBy")
  deliveriesCreated        OrderDelivery[]          @relation("OrderDeliveryCreatedBy")
  deliveriesReversed       OrderDelivery[]          @relation("OrderDeliveryReversedBy")
  customerPaymentsCreated  CustomerPayment[]        @relation("CustomerPaymentCreatedBy")
  customerPaymentsReversed CustomerPayment[]        @relation("CustomerPaymentReversedBy")
  deliveriesAssigned       OrderDelivery[]          @relation("DeliveryDriver")
  driverPositions          DriverPosition[]
  driverProfiles           DriverProfile[]
  driverIncidentsReported  DriverIncident[]
  deliveryStatusLogs       OrderDeliveryStatusLog[] @relation("DeliveryStatusLogChangedBy")
  financialMovements       FinancialMovement[]      @relation("FinancialMovementCreatedBy")
  financialTransfers       FinancialTransfer[]      @relation("FinancialTransferCreatedBy")
  receivableDocuments      ReceivableDocument[]     @relation("ReceivableDocumentCreatedBy")
  receivablePayments       ReceivablePayment[]      @relation("ReceivablePaymentCreatedBy")
  receivablePaymentsReversed ReceivablePayment[]    @relation("ReceivablePaymentReversedBy")
  receivableAllocationsReversed ReceivableAllocation[] @relation("ReceivableAllocationReversedBy")

  @@unique([email])
  @@map("user")
}

model Tenant {
  id                      Int                       @id @default(autoincrement())
  name                    String                    @db.VarChar(160)
  slug                    String                    @unique @db.VarChar(120)
  publicGuid              String                    @unique @db.VarChar(36)
  businessType            String?                   @db.VarChar(80)
  status                  String                    @default("active") @db.VarChar(20)
  defaultCurrency         String                    @default("ARS") @db.VarChar(3)
  locale                  String                    @default("es-AR") @db.VarChar(12)
  timeZone                String                    @default("America/Argentina/Buenos_Aires") @db.VarChar(80)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  businessInfo            BusinessInfo?
  categories              Category[]
  products                Product[]
  productCategories       ProductCategory[]
  events                  Event[]
  openingHours            OpeningHour[]
  testimonials            Testimonial[]
  memberships             TenantMembership[]
  roles                   Role[]
  auditLogs               AuditLog[]
  promotions              Promotion[]
  promotionProducts       PromotionProduct[]
  promotionCategories     PromotionCategory[]
  promotionUsages         PromotionUsage[]
  reservationSettings     ReservationSettings?
  reservationBlocks       ReservationBlock[]
  reservations            Reservation[]
  notifications           Notification[]
  productVariants         ProductVariant[]
  productExtras           ProductExtra[]
  productOptionGroups     ProductOptionGroup[]
  diningTables            DiningTable[]
  customerOrders          CustomerOrder[]
  orderIdempotencies      OrderIdempotency[]
  analyticsEvents         AnalyticsEvent[]
  brandSettings           BrandSettings?
  subscription            TenantSubscription?
  onboarding              OnboardingProgress?
  notificationSettings    NotificationSettings?
  legalPages              LegalPage[]
  invoiceSettings         InvoiceSettings?
  helpArticles            HelpArticle[]
  supportTickets          SupportTicket[]
  mediaAssets             MediaAsset[]
  loyaltyCustomers        LoyaltyCustomer[]
  loyaltyRewards          LoyaltyReward[]
  successCases            SuccessCase[]
  branches                Branch[]
  inventoryStocks         InventoryStock[]
  stockMovements          StockMovement[]
  invoices                InvoiceRecord[]
  documentTemplates       DocumentTemplate[]
  invoiceDocuments        InvoiceDocumentArtifact[]
  integrations            IntegrationSettings[]
  seoPages                SeoPage[]
  redirectRules           RedirectRule[]
  errorLogs               ErrorLog[]
  passwordResetRequests   PasswordResetRequest[]
  platformPayments        PlatformPayment[]
  branchLicenses          BranchLicense[]
  branchProducts          BranchProduct[]
  loyaltyBranchLinks      LoyaltyBranchLink[]
  tableSectors            TableSector[]
  tableSessions           TableSession[]
  tableSessionEvents      TableSessionEvent[]
  activePaletteId         Int?
  activePalette           ThemePalette?             @relation("TenantActivePalette", fields: [activePaletteId], references: [id], onDelete: SetNull)
  themePalettes           ThemePalette[]            @relation("TenantThemePalettes")
  kitchenStations         KitchenStation[]
  printAreas              PrintArea[]
  printAreaProducts       PrintAreaProduct[]
  printAreaCategories     PrintAreaCategory[]
  printDestinations       PrintDestination[]
  printJobs               PrintJob[]
  productPrices           ProductPrice[]
  productComboItems       ProductComboItem[]
  recipeIngredients       RecipeIngredient[]
  unitConversions         UnitConversion[]
  ingredientCostHistory   IngredientCostHistory[]
  inventorySettings       InventorySettings?
  stockTransfers          StockTransfer[]
  inventoryCountSessions  InventoryCountSession[]
  suppliers               Supplier[]
  supplierBranches        SupplierBranch[]
  supplierLedgerEntries   SupplierLedgerEntry[]
  expenseCategories       ExpenseCategory[]
  documentSequences       DocumentSequence[]
  purchaseOrders          PurchaseOrder[]
  purchaseReceipts        PurchaseReceipt[]
  purchaseInvoices        PurchaseInvoice[]
  purchasePayments        PurchasePayment[]
  expenses                Expense[]
  recurringExpenses       RecurringExpense[]
  orderDeliveries         OrderDelivery[]
  customerPayments        CustomerPayment[]
  externalOrders          ExternalOrder[]
  externalEvents          ExternalEvent[]
  financialAccounts       FinancialAccount[]
  financialMovements      FinancialMovement[]
  financialTransfers      FinancialTransfer[]
  receivableDocuments     ReceivableDocument[]
  receivablePayments      ReceivablePayment[]
  receivableAllocations   ReceivableAllocation[]
  driverPositions         DriverPosition[]
  deliveryProviderConfigs DeliveryProviderConfig[]
  driverProfiles          DriverProfile[]
  driverBranches          DriverBranch[]
  driverIncidents         DriverIncident[]
  deliveryStatusLogs      OrderDeliveryStatusLog[]

  @@map("tenant")
}

/**
 * @summary Configuración global de MenuClick, independiente de cualquier tenant.
 */
model PlatformSettings {
  id              Int               @id @default(1)
  name            String            @default("MenuClick") @db.VarChar(120)
  logoUrl         String?           @db.VarChar(500)
  isotypeUrl      String?           @db.VarChar(500)
  faviconUrl      String?           @db.VarChar(500)
  activePaletteId Int?
  activePalette   PlatformPalette?  @relation("PlatformActivePalette", fields: [activePaletteId], references: [id], onDelete: SetNull)
  palettes        PlatformPalette[] @relation("PlatformPalettes")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("platformsettings")
}

/**
 * @summary Paleta global de MenuClick para marketing, login y Platform.
 */
model PlatformPalette {
  id              Int                @id @default(autoincrement())
  settingsId      Int                @default(1)
  name            String             @db.VarChar(120)
  isSystem        Boolean            @default(false)
  presetKey       String?            @db.VarChar(50)
  baseMode        String             @default("dark") @db.VarChar(10)
  primary         String             @db.VarChar(7)
  secondary       String             @db.VarChar(7)
  accent          String             @db.VarChar(7)
  background      String             @db.VarChar(7)
  surface         String             @db.VarChar(7)
  surfaceElevated String             @db.VarChar(7)
  text            String             @db.VarChar(7)
  textMuted       String             @db.VarChar(7)
  border          String             @db.VarChar(7)
  success         String             @db.VarChar(7)
  warning         String             @db.VarChar(7)
  danger          String             @db.VarChar(7)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  settings        PlatformSettings   @relation("PlatformPalettes", fields: [settingsId], references: [id], onDelete: Cascade)
  activeFor       PlatformSettings[] @relation("PlatformActivePalette")

  @@unique([settingsId, presetKey])
  @@index([settingsId, isSystem, name])
  @@map("platformpalette")
}

model Role {
  id          Int                @id @default(autoincrement())
  tenantId    Int
  key         String             @db.VarChar(60)
  name        String             @db.VarChar(100)
  description String?            @db.VarChar(255)
  system      Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships TenantMembership[]

  @@unique([tenantId, key])
  @@map("role")
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique @db.VarChar(100)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(255)
  roles       RolePermission[]

  @@map("permission")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("rolepermission")
}

model TenantMembership {
  id           Int                @id @default(autoincrement())
  tenantId     Int
  userId       Int
  roleId       Int
  status       String             @default("active") @db.VarChar(20)
  allBranches  Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions     AuthSession[]
  branchAccess BranchMembership[]
  authHandoffs AuthHandoff[]

  @@unique([tenantId, userId])
  @@index([userId, status])
  @@map("tenantmembership")
}

model AuthSession {
  id           Int               @id @default(autoincrement())
  userId       Int
  membershipId Int?
  branchId     Int?
  context      String            @default("tenant") @db.VarChar(20)
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime          @default(now())
  lastSeenAt   DateTime          @default(now())
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership   TenantMembership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch       Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([membershipId, context])
  @@index([branchId])
  @@map("authsession")
}

/**
 * @summary Transferencia de autenticación de un login general al host administrativo del tenant.
 */
model AuthHandoff {
  id           Int              @id @default(autoincrement())
  tokenHash    String           @unique @db.VarChar(64)
  userId       Int
  membershipId Int
  branchId     Int?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([expiresAt, usedAt])
  @@map("authhandoff")
}

model LoginAttempt {
  id         BigInt   @id @default(autoincrement())
  emailHash  String   @db.VarChar(64)
  ipHash     String   @db.VarChar(64)
  successful Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([emailHash, createdAt])
  @@index([ipHash, createdAt])
  @@map("loginattempt")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  tenantId   Int?
  userId     Int?
  branchId   Int?
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(80)
  entityId   String?  @db.VarChar(80)
  oldValues  Json?
  newValues  Json?
  ipAddress  String?  @db.VarChar(64)
  result     String   @default("success") @db.VarChar(20)
  createdAt  DateTime @default(now())
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, createdAt])
  @@index([entityType, entityId])
  @@map("auditlog")
}

model Plan {
  id             Int                  @id @default(autoincrement())
  slug           String               @unique @db.VarChar(100)
  name           String               @db.VarChar(140)
  summary        String               @db.VarChar(500)
  audience       String?              @db.VarChar(255)
  type           String               @default("implementation") @db.VarChar(30)
  billingMode    String               @default("one_time") @db.VarChar(30)
  badge          String?              @db.VarChar(80)
  highlighted    Boolean              @default(false)
  active         Boolean              @default(true)
  displayOrder   Int                  @default(0)
  trialDays      Int                  @default(7)
  capacity       Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  prices         PlanPrice[]
  features       PlanFeature[]
  subscriptions  TenantSubscription[]
  leads          SalesLead[]
  branchLicenses BranchLicense[]

  @@index([active, type, displayOrder])
  @@map("plan")
}

model PlanPrice {
  id            Int       @id @default(autoincrement())
  planId        Int
  currency      String    @default("ARS") @db.VarChar(3)
  amount        Decimal?  @db.Decimal(14, 0)
  billingPeriod String    @default("once") @db.VarChar(20)
  active        Boolean   @default(true)
  validFrom     DateTime  @default(now())
  validUntil    DateTime?
  plan          Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, active, validFrom])
  @@map("planprice")
}

model Feature {
  id           Int           @id @default(autoincrement())
  key          String        @unique @db.VarChar(100)
  name         String        @db.VarChar(180)
  description  String?       @db.VarChar(500)
  category     String        @default("general") @db.VarChar(80)
  displayOrder Int           @default(0)
  active       Boolean       @default(true)
  plans        PlanFeature[]

  @@index([category, displayOrder])
  @@map("feature")
}

model PlanFeature {
  id           Int     @id @default(autoincrement())
  planId       Int
  featureId    Int
  included     Boolean @default(true)
  detail       String? @db.VarChar(255)
  displayOrder Int     @default(0)
  plan         Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature      Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@index([planId, displayOrder])
  @@map("planfeature")
}

model SalesLead {
  id                  Int                 @id @default(autoincrement())
  status              String              @default("new") @db.VarChar(30)
  fullName            String              @db.VarChar(160)
  businessName        String              @db.VarChar(180)
  businessType        String              @db.VarChar(80)
  city                String              @db.VarChar(100)
  province            String              @db.VarChar(100)
  phone               String              @db.VarChar(60)
  email               String              @db.VarChar(190)
  approximateProducts Int?
  branches            Int                 @default(1)
  planId              Int?
  requiredFeatures    Json?
  approximateBudget   String?             @db.VarChar(100)
  message             String?             @db.Text
  consent             Boolean             @default(false)
  source              String              @default("direct") @db.VarChar(100)
  ipHash              String?             @db.VarChar(64)
  assignedToId        Int?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  plan                Plan?               @relation(fields: [planId], references: [id], onDelete: SetNull)
  assignedTo          User?               @relation("AssignedSalesLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  history             LeadStatusHistory[]

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@index([ipHash, createdAt])
  @@map("saleslead")
}

model LeadStatusHistory {
  id         Int       @id @default(autoincrement())
  leadId     Int
  userId     Int?
  fromStatus String?   @db.VarChar(30)
  toStatus   String    @db.VarChar(30)
  note       String?   @db.VarChar(500)
  createdAt  DateTime  @default(now())
  lead       SalesLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("leadstatushistory")
}

model Allergen {
  id       Int               @id @default(autoincrement())
  tenantId Int
  name     String            @db.VarChar(100)
  slug     String            @db.VarChar(100)
  products ProductAllergen[]

  @@unique([tenantId, slug])
  @@map("allergen")
}

model ProductAllergen {
  id         Int      @id @default(autoincrement())
  productId  Int
  allergenId Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@unique([productId, allergenId])
  @@map("productallergen")
}

model ProductRelation {
  id               Int     @id @default(autoincrement())
  productId        Int
  relatedProductId Int
  relationType     String  @default("recommended") @db.VarChar(30)
  product          Product @relation("ProductRelationFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct   Product @relation("ProductRelationTo", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedProductId, relationType])
  @@map("productrelation")
}

model CommercialFaq {
  id           Int     @id @default(autoincrement())
  audience     String  @default("plans") @db.VarChar(40)
  question     String  @db.VarChar(255)
  answer       String  @db.Text
  active       Boolean @default(true)
  displayOrder Int     @default(0)

  @@index([audience, active, displayOrder])
  @@map("commercialfaq")
}

model Promotion {
  id               Int                 @id @default(autoincrement())
  tenantId         Int
  branchId         Int?
  slug             String              @db.VarChar(180)
  name             String              @db.VarChar(180)
  description      String              @db.VarChar(700)
  imageUrl         String?             @db.VarChar(255)
  type             String              @db.VarChar(30)
  discountValue    Decimal?            @db.Decimal(12, 2)
  minimumPurchase  Decimal?            @db.Decimal(12, 2)
  buyQuantity      Int?
  receiveQuantity  Int?
  startAt          DateTime?
  endAt            DateTime?
  startTime        DateTime?           @db.Time(0)
  endTime          DateTime?           @db.Time(0)
  daysOfWeek       Json?
  conditions       String?             @db.Text
  code             String?             @db.VarChar(80)
  usageLimit       Int?
  perCustomerLimit Int?
  usedCount        Int                 @default(0)
  status           String              @default("published") @db.VarChar(20)
  publishAt        DateTime?
  priority         Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  products         PromotionProduct[]
  categories       PromotionCategory[]
  orders           CustomerOrder[]
  usages           PromotionUsage[]

  @@unique([tenantId, slug])
  @@index([tenantId, branchId, status, startAt, endAt])
  @@map("promotion")
}

model PromotionUsage {
  id            Int           @id @default(autoincrement())
  tenantId      Int
  promotionId   Int
  orderId       Int           @unique
  customerId    Int?
  customerEmail String?       @db.VarChar(190)
  createdAt     DateTime      @default(now())
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promotion     Promotion     @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  order         CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([promotionId, customerEmail])
  @@index([tenantId, createdAt])
  @@map("promotionusage")
}

model PromotionProduct {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  promotionId Int
  productId   Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([tenantId, productId])
  @@map("promotionproduct")
}

model PromotionCategory {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  promotionId Int
  categoryId  Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([promotionId, categoryId])
  @@index([tenantId, categoryId])
  @@map("promotioncategory")
}

model ReservationSettings {
  id                 Int      @id @default(autoincrement())
  tenantId           Int      @unique
  enabled            Boolean  @default(true)
  capacityPerSlot    Int      @default(30)
  slotInterval       Int      @default(30)
  minimumLeadMinutes Int      @default(120)
  minimumLeadHours   Int      @default(2)
  maximumAdvanceDays Int      @default(60)
  maximumPartySize   Int      @default(20)
  defaultDuration    Int      @default(120)
  sectors            Json?
  policy             String?  @db.Text
  confirmationMode   String   @default("manual") @db.VarChar(20)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("reservationsettings")
}

model ReservationBlock {
  id        Int       @id @default(autoincrement())
  tenantId  Int
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  startTime DateTime? @db.Time(0)
  endTime   DateTime? @db.Time(0)
  reason    String    @db.VarChar(255)
  branchId  Int?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId, startDate, endDate])
  @@map("reservationblock")
}

model Reservation {
  id                Int                        @id @default(autoincrement())
  tenantId          Int
  branchId          Int?
  reference         String                     @unique @db.VarChar(24)
  status            String                     @default("pending") @db.VarChar(24)
  reservationDate   DateTime                   @db.Date
  reservationTime   DateTime                   @db.Time(0)
  partySize         Int
  sector            String?                    @db.VarChar(100)
  customerName      String                     @db.VarChar(160)
  phone             String                     @db.VarChar(60)
  email             String                     @db.VarChar(190)
  notes             String?                    @db.Text
  reason            String?                    @db.VarChar(160)
  acceptedPolicy    Boolean                    @default(false)
  source            String                     @default("website") @db.VarChar(60)
  ipHash            String?                    @db.VarChar(64)
  estimatedDuration Int?
  deletedAt         DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  tenant            Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch?                    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  history           ReservationStatusHistory[]

  @@index([tenantId, branchId, reservationDate, reservationTime])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, deletedAt])
  @@index([ipHash, createdAt])
  @@map("reservation")
}

model ReservationStatusHistory {
  id            Int         @id @default(autoincrement())
  reservationId Int
  userId        Int?
  fromStatus    String?     @db.VarChar(24)
  toStatus      String      @db.VarChar(24)
  note          String?     @db.VarChar(500)
  createdAt     DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, createdAt])
  @@map("reservationstatushistory")
}

model Notification {
  id        BigInt    @id @default(autoincrement())
  tenantId  Int
  branchId  Int?
  type      String    @db.VarChar(60)
  title     String    @db.VarChar(180)
  message   String    @db.VarChar(700)
  link      String?   @db.VarChar(500)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, readAt, createdAt])
  @@map("notification")
}

model ProductVariant {
  id              Int                 @id @default(autoincrement())
  tenantId        Int
  productId       Int
  name            String              @db.VarChar(120)
  priceAdjustment Decimal             @default(0) @db.Decimal(12, 2)
  active          Boolean             @default(true)
  sortOrder       Int                 @default(0)
  groupId         Int?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product         Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  group           ProductOptionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([tenantId, productId, active, sortOrder])
  @@map("productvariant")
}

model ProductExtra {
  id        Int                 @id @default(autoincrement())
  tenantId  Int
  productId Int
  name      String              @db.VarChar(120)
  price     Decimal             @default(0) @db.Decimal(12, 2)
  active    Boolean             @default(true)
  sortOrder Int                 @default(0)
  groupId   Int?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     ProductOptionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([tenantId, productId, active, sortOrder])
  @@map("productextra")
}

/**
 * @summary Grupo de selección que organiza variantes o agregados sin romper opciones históricas.
 */
model ProductOptionGroup {
  id            Int              @id @default(autoincrement())
  tenantId      Int
  productId     Int
  kind          String           @db.VarChar(20)
  name          String           @db.VarChar(120)
  required      Boolean          @default(false)
  minSelections Int              @default(0)
  maxSelections Int              @default(1)
  sortOrder     Int              @default(0)
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants      ProductVariant[]
  extras        ProductExtra[]

  @@index([tenantId, productId, kind, sortOrder])
  @@map("productoptiongroup")
}

/**
 * @summary Precio de un producto por canal de venta (salón, mostrador, delivery, carta online).
 * Opcional y con vigencia/horario propio cuando el negocio lo necesita; el precio
 * base del producto se usa cuando no hay entrada para el canal.
 */
model ProductPrice {
  id         Int       @id @default(autoincrement())
  tenantId   Int
  productId  Int
  channel    String    @db.VarChar(20)
  price      Decimal   @db.Decimal(12, 2)
  active     Boolean   @default(true)
  validFrom  DateTime?
  validUntil DateTime?
  startTime  DateTime? @db.Time(0)
  endTime    DateTime? @db.Time(0)
  daysOfWeek Json?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, channel])
  @@index([tenantId, channel, active])
  @@map("productprice")
}

/**
 * @summary Composición fija de un combo: producto vendible + otros productos vendibles.
 * El combo agrupa productos reales de la carta (p. ej. hamburguesa + papas + gaseosa).
 */
model ProductComboItem {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  productId     Int
  itemProductId Int
  quantity      Decimal  @default(1) @db.Decimal(12, 3)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product  @relation("ComboOwner", fields: [productId], references: [id], onDelete: Cascade)
  item          Product  @relation("ComboPart", fields: [itemProductId], references: [id], onDelete: Cascade)

  @@unique([productId, itemProductId])
  @@index([itemProductId])
  @@map("productcomboitem")
}

/**
 * @summary Receta de un producto: cantidad de cada ingrediente que tiene stock.
 * Los ingredientes son productos reales con control de inventario; la receta
 * conecta el producto compuesto con su inventario sin duplicar modelos.
 */
model RecipeIngredient {
  id                  Int      @id @default(autoincrement())
  tenantId            Int
  productId           Int
  ingredientProductId Int
  quantity            Decimal  @default(1) @db.Decimal(12, 3)
  unit                String   @default("unidad") @db.VarChar(40)
  /**
   * Rendimiento de la preparación/ingrediente al usarse en la receta: 100 = sin merma.
   */
  yieldPercent        Decimal  @default(100) @db.Decimal(6, 3)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product             Product  @relation("RecipeOwner", fields: [productId], references: [id], onDelete: Cascade)
  ingredient          Product  @relation("RecipePart", fields: [ingredientProductId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientProductId])
  @@index([ingredientProductId])
  @@map("recipeingredient")
}

/**
 * @summary Conversión de unidades personalizada por negocio (p. ej. 1 bolsa = 25 kg).
 * Complementa las conversiones estándar (g/kg, ml/l, unidad) cuando el negocio
 * compra en unidades propias. El factor indica cuántas unidades de destino hay
 * en una unidad de origen (1 bolsa = 25 kg → factor 25).
 */
model UnitConversion {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  fromUnit  String   @db.VarChar(40)
  toUnit    String   @db.VarChar(40)
  factor    Decimal  @db.Decimal(18, 9)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fromUnit, toUnit])
  @@index([tenantId])
  @@map("unitconversion")
}

/**
 * @summary Historial de costos de un ingrediente.
 * Cada cambio de costo se registra con fecha y autor: el costo histórico de
 * ventas pasadas nunca se reescribe (el consumo guarda su propio snapshot).
 */
model IngredientCostHistory {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  productId   Int
  cost        Decimal  @db.Decimal(12, 4)
  unit        String   @db.VarChar(40)
  changedById Int?
  reason      String?  @db.VarChar(300)
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, createdAt])
  @@map("ingredientcosthistory")
}

/**
 * @summary Sector configurable del salón (salón, terraza, barra, etc.) por sucursal.
 */
model TableSector {
  id        Int           @id @default(autoincrement())
  tenantId  Int
  branchId  Int
  name      String        @db.VarChar(100)
  sortOrder Int           @default(0)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables    DiningTable[]

  @@unique([tenantId, branchId, name])
  @@index([tenantId, branchId, active, sortOrder])
  @@map("tablesector")
}

/**
 * @summary Estación de preparación de la cocina (cocina, barra, cafetería).
 * Enruta visualmente los productos hacia el lugar que los prepara; queda
 * preparada la base para ruteo a impresoras o monitores dedicados.
 */
model KitchenStation {
  id        Int       @id @default(autoincrement())
  tenantId  Int
  branchId  Int
  name      String    @db.VarChar(100)
  type      String    @default("KITCHEN") @db.VarChar(20)
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([tenantId, branchId, name])
  @@index([tenantId, branchId, active, sortOrder])
  @@map("kitchenstation")
}

/**
 * @summary Área de impresión de comandas por sucursal (cocina, barra, cafetería, caja…).
 * Configuración declarativa: no imprime nada por sí misma. Los productos y
 * categorías se asocian a un área para que la futura impresión sepa a dónde ir.
 */
model PrintArea {
  id           Int                 @id @default(autoincrement())
  tenantId     Int
  branchId     Int
  name         String              @db.VarChar(100)
  sortOrder    Int                 @default(0)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  products     PrintAreaProduct[]
  categories   PrintAreaCategory[]
  destinations PrintDestination[]
  jobs         PrintJob[]

  @@unique([tenantId, branchId, name])
  @@index([tenantId, branchId, active, sortOrder])
  @@map("printarea")
}

/**
 * @summary Asociación producto → área de impresión (un producto puede ir a varias áreas).
 */
model PrintAreaProduct {
  id        Int       @id @default(autoincrement())
  tenantId  Int
  areaId    Int
  productId Int
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  area      PrintArea @relation(fields: [areaId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([areaId, productId])
  @@index([productId])
  @@map("printareaproduct")
}

/**
 * @summary Asociación categoría → área de impresión.
 */
model PrintAreaCategory {
  id         Int       @id @default(autoincrement())
  tenantId   Int
  areaId     Int
  categoryId Int
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  area       PrintArea @relation(fields: [areaId], references: [id], onDelete: Cascade)
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([areaId, categoryId])
  @@index([categoryId])
  @@map("printareacategory")
}

/**
 * @summary Destino de impresión opcional (Ethernet, Bluetooth, USB o servicio local).
 * Guarda solo configuración declarativa; la conexión real llega en una etapa futura.
 */
model PrintDestination {
  id         Int        @id @default(autoincrement())
  tenantId   Int
  branchId   Int
  areaId     Int?
  name       String     @db.VarChar(120)
  type       String     @default("ETHERNET") @db.VarChar(30)
  connection String?    @db.Text
  status     String     @default("unknown") @db.VarChar(20)
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  area       PrintArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  jobs       PrintJob[]

  @@index([tenantId, branchId, active])
  @@map("printdestination")
}

/**
 * @summary Comanda en cola, independiente del formato físico de impresión.
 * Estados conceptuales: pending → processing → printed (o failed/cancelled).
 * Se genera a partir de un pedido real cuando exista un proveedor de impresión.
 */
model PrintJob {
  id            Int               @id @default(autoincrement())
  tenantId      Int
  branchId      Int
  orderId       Int
  areaId        Int?
  destinationId Int?
  kind          String            @default("comanda") @db.VarChar(30)
  status        String            @default("pending") @db.VarChar(20)
  payload       Json
  error         String?           @db.VarChar(500)
  printedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  order         CustomerOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  area          PrintArea?        @relation(fields: [areaId], references: [id], onDelete: SetNull)
  destination   PrintDestination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, status, createdAt])
  @@index([orderId])
  @@map("printjob")
}

/**
 * @summary Ocupación vigente de una mesa: quién está, cuántos son y qué se consumió.
 * Una mesa tiene como máximo una sesión abierta (closedAt = null) a la vez.
 */
model TableSession {
  id             Int                 @id @default(autoincrement())
  tenantId       Int
  branchId       Int
  tableId        Int
  status         String              @default("occupied") @db.VarChar(24)
  customerName   String?             @db.VarChar(160)
  phone          String?             @db.VarChar(60)
  partySize      Int                 @default(1)
  notes          String?             @db.Text
  openedAt       DateTime            @default(now())
  closedAt       DateTime?
  closedByUserId Int?
  waiterUserId   Int?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table          DiningTable         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  waiter         User?               @relation("WaiterTableSessions", fields: [waiterUserId], references: [id], onDelete: SetNull)
  closedBy       User?               @relation("CloserTableSessions", fields: [closedByUserId], references: [id], onDelete: SetNull)
  orders         CustomerOrder[]
  events         TableSessionEvent[]

  @@index([tenantId, branchId, closedAt, tableId])
  @@index([tenantId, tableId, closedAt])
