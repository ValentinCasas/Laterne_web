  availabilityOverride String?  @db.VarChar(30)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch               Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([tenantId, branchId, active, sortOrder])
  @@map("branchproduct")
}

/**
 * @summary Entitlement operativo de una sucursal dentro de la suscripción del tenant.
 * Una sucursal puede tener varias licencias (p. ej. una activa y otra de refuerzo
 * con cupos adicionales). La capacidad de usuarios permitidos de una sucursal es
 * la suma de los cupos de sus licencias operativas vigentes.
 */
model BranchLicense {
  id               Int       @id @default(autoincrement())
  tenantId         Int
  branchId         Int
  planId           Int?
  status           String    @default("DRAFT") @db.VarChar(24)
  startsAt         DateTime  @default(now())
  currentPeriodEnd DateTime?
  graceUntil       DateTime?
  priceOverride    Decimal?  @db.Decimal(14, 2)
  pricePerUser     Decimal?  @db.Decimal(14, 2)
  /**
   * Cupos de usuarios permitidos por esta licencia. 0 = usar la capacidad del plan.
   */
  usersAllowed     Int       @default(0)
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  plan             Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, status])
  @@index([tenantId, status, currentPeriodEnd])
  @@map("branchlicense")
}

/**
 * @summary Vínculo de un cliente del tenant con una sucursal donde interactuó, sin duplicar identidad.
 */
model LoyaltyBranchLink {
  id             Int             @id @default(autoincrement())
  tenantId       Int
  branchId       Int
  customerId     Int
  lastActivityAt DateTime        @default(now())
  createdAt      DateTime        @default(now())
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer       LoyaltyCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([branchId, customerId])
  @@index([tenantId, customerId])
  @@map("loyaltybranchlink")
}

/**
 * @summary Acceso explícito de una membresía a una o varias sucursales del mismo tenant.
 */
model BranchMembership {
