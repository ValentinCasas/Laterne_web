  whatsapp           String?                 @db.VarChar(60)
  latitude           Decimal?                @db.Decimal(10, 7)
  longitude          Decimal?                @db.Decimal(10, 7)
  geofenceRadius     Int?                    @default(150)
  geofenceEnabled    Boolean                 @default(false)
  deliveryFee        Decimal                 @default(0) @db.Decimal(12, 2)
  minimumOrder       Decimal                 @default(0) @db.Decimal(12, 2)
  orderPrefix        String                  @default("PED") @db.VarChar(12)
  isPrimary          Boolean                 @default(false)
  active             Boolean                 @default(true)
  inheritLanding     Boolean                 @default(true)
  inheritBrand       Boolean                 @default(true)
  landingContent     Json?
  brandContent       Json?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tables             DiningTable[]
  orders             CustomerOrder[]
  inventoryStocks    InventoryStock[]
  invoices           InvoiceRecord[]
  membershipAccess   BranchMembership[]
  reservations       Reservation[]
  reservationBlocks  ReservationBlock[]
  licenses           BranchLicense[]
  productAssignments BranchProduct[]
  categories         Category[]
  events             Event[]
  openingHours       OpeningHour[]
  promotions         Promotion[]
  testimonials       Testimonial[]
  notifications      Notification[]
  mediaAssets        MediaAsset[]
  analyticsEvents    AnalyticsEvent[]
  auditLogs          AuditLog[]
  sessions           AuthSession[]
  loyaltyLinks       LoyaltyBranchLink[]
  tableSectors       TableSector[]
  tableSessions      TableSession[]
  tableSessionEvents TableSessionEvent[]
  kitchenStations    KitchenStation[]
  printAreas         PrintArea[]
  printDestinations  PrintDestination[]
  printJobs          PrintJob[]
  orderDeliveries    OrderDelivery[]
  supplierBranches   SupplierBranch[]
  purchaseOrders     PurchaseOrder[]
  purchaseReceipts   PurchaseReceipt[]
  purchaseInvoices   PurchaseInvoice[]
  expenses           Expense[]
  transfersFrom      StockTransfer[]         @relation("TransferFrom")
  transfersTo        StockTransfer[]         @relation("TransferTo")
  countSessions      InventoryCountSession[]
  driverPositions    DriverPosition[]
  driverBranches     DriverBranch[]
  financialAccounts  FinancialAccount[]
  financialMovements FinancialMovement[]
  receivableDocuments ReceivableDocument[]
  receivablePayments ReceivablePayment[]

  @@map("branch")
}

/**
 * @summary Disponibilidad y precio opcional de un producto en una sucursal.
 */
model BranchProduct {
  id                   Int      @id @default(autoincrement())
  tenantId             Int
  branchId             Int
  productId            Int
  active               Boolean  @default(true)
  priceOverride        Decimal? @db.Decimal(12, 2)
  availabilityOverride String?  @db.VarChar(30)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch               Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([tenantId, branchId, active, sortOrder])
  @@map("branchproduct")
}

/**
 * @summary Entitlement operativo de una sucursal dentro de la suscripción del tenant.
 * Una sucursal puede tener varias licencias (p. ej. una activa y otra de refuerzo
 * con cupos adicionales). La capacidad de usuarios permitidos de una sucursal es
 * la suma de los cupos de sus licencias operativas vigentes.
 */
model BranchLicense {
  id               Int       @id @default(autoincrement())
  tenantId         Int
  branchId         Int
  planId           Int?
  status           String    @default("DRAFT") @db.VarChar(24)
  startsAt         DateTime  @default(now())
  currentPeriodEnd DateTime?
  graceUntil       DateTime?
  priceOverride    Decimal?  @db.Decimal(14, 2)
  pricePerUser     Decimal?  @db.Decimal(14, 2)
  /**
   * Cupos de usuarios permitidos por esta licencia. 0 = usar la capacidad del plan.
   */
  usersAllowed     Int       @default(0)
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  plan             Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, status])
  @@index([tenantId, status, currentPeriodEnd])
  @@map("branchlicense")
}

/**
 * @summary Vínculo de un cliente del tenant con una sucursal donde interactuó, sin duplicar identidad.
 */
model LoyaltyBranchLink {
  id             Int             @id @default(autoincrement())
  tenantId       Int
  branchId       Int
  customerId     Int
  lastActivityAt DateTime        @default(now())
  createdAt      DateTime        @default(now())
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer       LoyaltyCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([branchId, customerId])
  @@index([tenantId, customerId])
  @@map("loyaltybranchlink")
}

/**
 * @summary Acceso explícito de una membresía a una o varias sucursales del mismo tenant.
 */
model BranchMembership {
  id           Int              @id @default(autoincrement())
  membershipId Int
  branchId     Int
  createdAt    DateTime         @default(now())
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([membershipId, branchId])
  @@index([branchId])
  @@map("branchmembership")
}

model InventoryStock {
  id         Int                  @id @default(autoincrement())
  tenantId   Int
  branchId   Int
  productId  Int
  tracked    Boolean              @default(false)
  current    Decimal              @default(0) @db.Decimal(12, 3)
  /**
   * Unidades comprometidas (reservas): el disponible es `current - reserved`.
   */
  reserved   Decimal              @default(0) @db.Decimal(12, 3)
  minimum    Decimal              @default(0) @db.Decimal(12, 3)
  unit       String               @default("unidad") @db.VarChar(40)
  updatedAt  DateTime             @updatedAt
  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch     Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product    Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements  StockMovement[]
  countItems InventoryCountItem[]

  @@unique([branchId, productId])
  @@index([tenantId, tracked, current])
  @@map("inventorystock")
}

model StockMovement {
  id            BigInt         @id @default(autoincrement())
  tenantId      Int
  stockId       Int
  orderId       Int?
  transferId    Int?
  userId        Int?
  type          String         @db.VarChar(30)
  quantity      Decimal        @db.Decimal(12, 3)
  balanceAfter  Decimal        @db.Decimal(12, 3)
  /**
   * Costo unitario en el momento del movimiento: snapshot que nunca se reescribe.
   */
  unitCost      Decimal?       @db.Decimal(14, 4)
  /**
   * Saldo reservado tras un movimiento de reserva/liberación (null si no aplica).
   */
  reservedAfter Decimal?       @db.Decimal(12, 3)
  /**
   * Referencia legible del documento origen (pedido, transferencia, conteo, merma).
   */
  reference     String?        @db.VarChar(80)
  reason        String         @db.VarChar(300)
  createdAt     DateTime       @default(now())
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stock         InventoryStock @relation(fields: [stockId], references: [id], onDelete: Cascade)
  order         CustomerOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  transfer      StockTransfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([stockId, createdAt])
  @@index([orderId])
  @@index([transferId])
  @@index([tenantId, type, createdAt])
  @@map("stockmovement")
}

/**
 * @summary Configuración de inventario por negocio (política de venta sin stock).
 * `strict` impide vender sin stock disponible; `warn` permite vender y registra
 * stock negativo con advertencia.
 */
model InventorySettings {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @unique
  stockPolicy String   @default("strict") @db.VarChar(20)
  /**
   * Política de costo al facturar compras: `product` actualiza el costo actual, `history` solo registra historial.
   */
  costPolicy  String   @default("product") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("inventorysettings")
}

/**
 * @summary Proveedor del negocio para pedidos, recepciones y gastos.
 * Incluye datos de contacto, condiciones, cuenta corriente y sucursales habilitadas.
 */
model Supplier {
  id               Int                   @id @default(autoincrement())
  tenantId         Int
  code             String?               @db.VarChar(40)
  name             String                @db.VarChar(180)
  taxId            String?               @db.VarChar(60)
  contactName      String?               @db.VarChar(120)
  phone            String?               @db.VarChar(40)
  email            String?               @db.VarChar(160)
  address          String?               @db.VarChar(240)
  paymentTerms     String?               @db.VarChar(80)
  currency         String                @default("ARS") @db.VarChar(3)
  status           String                @default("active") @db.VarChar(20)
  category         String?               @db.VarChar(80)
  creditLimit      Decimal?              @db.Decimal(14, 2)
  currentBalance   Decimal               @default(0) @db.Decimal(14, 2)
  blockedAt        DateTime?
  blockedReason    String?               @db.VarChar(300)
  notes            String?               @db.Text
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders   PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]
  purchaseInvoices PurchaseInvoice[]
  expenses         Expense[]
  branches         SupplierBranch[]
  ledgerEntries    SupplierLedgerEntry[]

  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@map("supplier")
}

/**
 * @summary Sucursales habilitadas para un proveedor (maestro N:M).
 */
model SupplierBranch {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  supplierId Int
  branchId   Int
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([supplierId, branchId])
  @@index([tenantId, branchId])
  @@map("supplierbranch")
}

/**
 * @summary Ledger inmutable de la cuenta corriente de un proveedor.
 * Cada entrada representa un hecho documentado: compra, factura, nota de crédito,
 * pago, devolución o ajuste. El saldo se calcula acumulando importes aplicados.
 */
model SupplierLedgerEntry {
  id              Int       @id @default(autoincrement())
  tenantId        Int
  supplierId      Int
  branchId        Int?
  type            String    @db.VarChar(30)
  referenceType   String?   @db.VarChar(40)
  referenceId     Int?
  documentNumber  String?   @db.VarChar(24)
  originalAmount  Decimal   @db.Decimal(14, 2)
  appliedAmount   Decimal   @default(0) @db.Decimal(14, 2)
  remainingAmount Decimal   @db.Decimal(14, 2)
  currency        String    @default("ARS") @db.VarChar(3)
  dueDate         DateTime?
  paidAt          DateTime?
  status          String    @default("open") @db.VarChar(20)
  notes           String?   @db.VarChar(300)
  createdById     Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier        Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdBy       User?     @relation("SupplierLedgerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, supplierId, status, dueDate])
  @@index([tenantId, supplierId, createdAt])
  @@map("supplierledgerentry")
}

/**
 * @summary Categoría configurable de gastos (Operación, Personal, Marketing, Administración…).
 * Se siembran ejemplos por tenant, pero el negocio puede crear las propias.
 */
model ExpenseCategory {
  id                Int                @id @default(autoincrement())
  tenantId          Int
  group             String             @default("Operación") @db.VarChar(60)
  name              String             @db.VarChar(120)
  active            Boolean            @default(true)
  sortOrder         Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  @@unique([tenantId, name])
  @@index([tenantId, group, active])
  @@map("expensecategory")
}

/**
 * @summary Contador de numeración por documento y tenant (OC-, RC-, GC-, GA-, PC-).
 * El incremento es atómico dentro de la transacción del documento.
 */
model DocumentSequence {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  prefix    String   @db.VarChar(10)
  lastValue Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, prefix])
  @@map("documentsequence")
}

/**
 * @summary Pedido de compra: intención de comprar mercadería a un proveedor.
 * Crear un pedido NO modifica inventario; solo la recepción física lo hace.
 */
model PurchaseOrder {
  id                Int                 @id @default(autoincrement())
  tenantId          Int
  branchId          Int
  supplierId        Int
  number            String              @db.VarChar(24)
  status            String              @default("draft") @db.VarChar(24)
  orderDate         DateTime            @default(now())
  expectedDate      DateTime?
  externalReference String?             @db.VarChar(120)
  notes             String?             @db.Text
  createdById       Int?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier          Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy         User?               @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items             PurchaseOrderItem[]
  receipts          PurchaseReceipt[]
  invoices          PurchaseInvoice[]

  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
  @@map("purchaseorder")
}

/**
 * @summary Línea de un pedido de compra con lo pedido, lo recibido acumulado y costos.
 */
model PurchaseOrderItem {
  id               Int                   @id @default(autoincrement())
  orderId          Int
  productId        Int
  quantity         Decimal               @db.Decimal(12, 3)
  unit             String                @default("unidad") @db.VarChar(40)
  unitCost         Decimal               @db.Decimal(14, 4)
  discountPercent  Decimal               @default(0) @db.Decimal(6, 2)
  taxPercent       Decimal               @default(0) @db.Decimal(6, 2)
  /**
   * Cantidad recibida acumulada; la pendiente es `quantity - receivedQuantity`.
   */
  receivedQuantity Decimal               @default(0) @db.Decimal(12, 3)
  sortOrder        Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  order            PurchaseOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptItems     PurchaseReceiptItem[]

  @@unique([orderId, productId])
  @@index([productId])
  @@map("purchaseorderitem")
}

/**
 * @summary Recepción física de mercadería: la única operación que aumenta stock.
 * Un pedido puede tener muchas recepciones parciales.
 */
model PurchaseReceipt {
  id          Int                      @id @default(autoincrement())
  tenantId    Int
  branchId    Int
  supplierId  Int
  orderId     Int?
  number      String                   @db.VarChar(24)
  receivedAt  DateTime                 @default(now())
  notes       String?                  @db.Text
  createdById Int?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier    Supplier                 @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  order       PurchaseOrder?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy   User?                    @relation("PurchaseReceiptCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items       PurchaseReceiptItem[]
  invoices    PurchaseInvoiceReceipt[]

  @@unique([tenantId, number])
  @@index([tenantId, branchId, receivedAt])
  @@map("purchasereceipt")
}

/**
 * @summary Línea de recepción: cantidad, unidad y costo informado al recibir.
 */
model PurchaseReceiptItem {
  id          Int                @id @default(autoincrement())
  receiptId   Int
  orderItemId Int?
  productId   Int
  quantity    Decimal            @db.Decimal(12, 3)
  unit        String             @default("unidad") @db.VarChar(40)
  unitCost    Decimal            @db.Decimal(14, 4)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  receipt     PurchaseReceipt    @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderItem   PurchaseOrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  product     Product            @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([receiptId, productId])
  @@index([productId])
  @@map("purchasereceiptitem")
}

/**
 * @summary Factura o gasto del proveedor vinculado a compras (GC-…).
 * Puede relacionarse con una o varias recepciones del mismo proveedor.
 */
model PurchaseInvoice {
  id                Int                      @id @default(autoincrement())
  tenantId          Int
  branchId          Int?
  supplierId        Int
  number            String                   @db.VarChar(24)
  status            String                   @default("draft") @db.VarChar(24)
  documentDate      DateTime                 @default(now())
  dueDate           DateTime?
  externalNumber    String?                  @db.VarChar(120)
  financialCategory String                   @default("insumos") @db.VarChar(80)
  currency          String                   @default("ARS") @db.VarChar(3)
  subtotal          Decimal                  @db.Decimal(12, 2)
  taxAmount         Decimal                  @default(0) @db.Decimal(12, 2)
  total             Decimal                  @db.Decimal(12, 2)
  paidAmount        Decimal                  @default(0) @db.Decimal(12, 2)
  notes             String?                  @db.Text
  attachmentId      Int?
  createdById       Int?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier          Supplier                 @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  attachment        MediaAsset?              @relation("InvoiceAttachment", fields: [attachmentId], references: [id], onDelete: SetNull)
  createdBy         User?                    @relation("PurchaseInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items             PurchaseInvoiceItem[]
  receipts          PurchaseInvoiceReceipt[]
  payments          PurchasePayment[]
  order             PurchaseOrder?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId           Int?

  @@unique([tenantId, number])
  @@index([tenantId, status, dueDate])
  @@map("purchaseinvoice")
}

/**
 * @summary Línea de factura: producto o concepto con cantidad, costo y descuento/impuesto.
 */
model PurchaseInvoiceItem {
  id              Int             @id @default(autoincrement())
  invoiceId       Int
  productId       Int?
  description     String          @db.VarChar(200)
  quantity        Decimal         @default(1) @db.Decimal(12, 3)
  unit            String          @default("unidad") @db.VarChar(40)
  unitCost        Decimal         @db.Decimal(14, 4)
  discountPercent Decimal         @default(0) @db.Decimal(6, 2)
  taxPercent      Decimal         @default(0) @db.Decimal(6, 2)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  invoice         PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("purchaseinvoiceitem")
}

/**
 * @summary Vínculo entre una factura y las recepciones que documenta (varias por factura).
 */
model PurchaseInvoiceReceipt {
  id        Int             @id @default(autoincrement())
  invoiceId Int
  receiptId Int
  invoice   PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receipt   PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, receiptId])
  @@map("purchaseinvoicereceipt")
}

/**
 * @summary Pago de una factura de compra o de un gasto (uno de los dos, nunca ambos).
 * El saldo pendiente se deriva de `total - paidAmount`.
 */
model PurchasePayment {
  id          Int              @id @default(autoincrement())
  tenantId    Int
  invoiceId   Int?
  expenseId   Int?
  number      String           @db.VarChar(24)
  amount      Decimal          @db.Decimal(12, 2)
  method      String           @default("transferencia") @db.VarChar(40)
  paidAt      DateTime         @default(now())
  notes       String?          @db.VarChar(240)
  createdById Int?
  createdAt   DateTime         @default(now())
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice     PurchaseInvoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  expense     Expense?         @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  createdBy   User?            @relation("PurchasePaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, invoiceId])
  @@index([tenantId, expenseId])
  @@map("purchasepayment")
}

/**
 * @summary Gasto que NO afecta inventario (alquiler, servicios, software…).
 * Se registra como documento con estado de pago y opcionalmente adjunto.
 */
model Expense {
  id                Int               @id @default(autoincrement())
  tenantId          Int
  branchId          Int?
  supplierId        Int?
  categoryId        Int
  number            String            @db.VarChar(24)
  status            String            @default("draft") @db.VarChar(24)
  expenseDate       DateTime          @default(now())
  dueDate           DateTime?
  amountNet         Decimal           @db.Decimal(12, 2)
  taxAmount         Decimal           @default(0) @db.Decimal(12, 2)
  total             Decimal           @db.Decimal(12, 2)
  paidAmount        Decimal           @default(0) @db.Decimal(12, 2)
  paymentMethod     String?           @db.VarChar(40)
  financialCategory String?           @db.VarChar(80)
  notes             String?           @db.Text
  attachmentId      Int?
  createdById       Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier          Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  category          ExpenseCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attachment        MediaAsset?       @relation("ExpenseAttachment", fields: [attachmentId], references: [id], onDelete: SetNull)
  createdBy         User?             @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  payments          PurchasePayment[]
  recurring         RecurringExpense? @relation("RecurringExpenseSource", fields: [recurringId], references: [id], onDelete: SetNull)
  recurringId       Int?

  @@unique([tenantId, number])
  @@index([tenantId, status, dueDate])
  @@map("expense")
}

/**
 * @summary Gasto recurrente previsto: genera sugerencias, nunca movimientos reales.
 * El usuario confirma y recién ahí se convierte en un gasto.
 */
model RecurringExpense {
  id          Int              @id @default(autoincrement())
  tenantId    Int
  categoryId  Int?
  name        String           @db.VarChar(160)
  amount      Decimal          @db.Decimal(12, 2)
  periodicity String           @default("monthly") @db.VarChar(20)
  dayOfMonth  Int?
  dayOfWeek   Int?
  nextDueDate DateTime         @default(now())
  active      Boolean          @default(true)
  notes       String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  expenses    Expense[]        @relation("RecurringExpenseSource")

  @@index([tenantId, active, nextDueDate])
  @@map("recurringexpense")
}

/**
 * @summary Transferencia de stock entre sucursales del mismo negocio.
 * La salida del origen y la entrada del destino son atómicas (misma transacción)
 * y quedan trazadas con movimientos `transfer_out` / `transfer_in`.
 */
model StockTransfer {
  id           Int             @id @default(autoincrement())
  tenantId     Int
  reference    String          @db.VarChar(24)
  fromBranchId Int
  toBranchId   Int
  productId    Int
  quantity     Decimal         @db.Decimal(12, 3)
  unit         String          @default("unidad") @db.VarChar(40)
  status       String          @default("completed") @db.VarChar(20)
  note         String?         @db.VarChar(300)
  createdById  Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromBranch   Branch          @relation("TransferFrom", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranch     Branch          @relation("TransferTo", fields: [toBranchId], references: [id], onDelete: Restrict)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy    User?           @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  movements    StockMovement[]

  @@unique([tenantId, reference])
  @@index([tenantId, fromBranchId, createdAt])
  @@index([tenantId, toBranchId, createdAt])
  @@map("stocktransfer")
}

/**
 * @summary Sesión de conteo físico de inventario de una sucursal.
 * Captura la cantidad de sistema al abrir; al completar, la diferencia se
 * ajusta con movimientos `count_adjustment` y queda registrado quién y cuándo.
 */
model InventoryCountSession {
  id            Int                  @id @default(autoincrement())
  tenantId      Int
  branchId      Int
  reference     String               @db.VarChar(24)
  status        String               @default("open") @db.VarChar(20)
  note          String?              @db.VarChar(300)
  startedById   Int?
  completedById Int?
  startedAt     DateTime             @default(now())
  completedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  startedBy     User?                @relation("CountStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  completedBy   User?                @relation("CountCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  items         InventoryCountItem[]

  @@unique([tenantId, reference])
  @@index([tenantId, branchId, status, startedAt])
  @@map("inventorycountsession")
}

/**
 * @summary Línea de un conteo físico: cantidad de sistema vs contada y su diferencia.
 */
model InventoryCountItem {
  id              Int                   @id @default(autoincrement())
  sessionId       Int
  stockId         Int?
  productId       Int
  systemQuantity  Decimal               @db.Decimal(12, 3)
  countedQuantity Decimal               @db.Decimal(12, 3)
  difference      Decimal               @default(0) @db.Decimal(12, 3)
  adjusted        Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  session         InventoryCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stock           InventoryStock?       @relation(fields: [stockId], references: [id], onDelete: SetNull)
  product         Product               @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([sessionId, productId])
  @@index([sessionId])
  @@map("inventorycountitem")
}

model InvoiceRecord {
  id            Int                      @id @default(autoincrement())
  tenantId      Int
  branchId      Int?
  orderId       Int                      @unique
  status        String                   @default("draft") @db.VarChar(24)
  documentType  String                   @default("internal_receipt") @db.VarChar(40)
  number        String?                  @db.VarChar(80)
  customerName  String                   @db.VarChar(180)
  customerTaxId String?                  @db.VarChar(40)
  subtotal      Decimal                  @db.Decimal(12, 2)
  tax           Decimal                  @default(0) @db.Decimal(12, 2)
  total         Decimal                  @db.Decimal(12, 2)
  currency      String                   @default("ARS") @db.VarChar(3)
  externalId    String?                  @db.VarChar(180)
  notes         String?                  @db.Text
  issuedAt      DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  order         CustomerOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  document      InvoiceDocumentArtifact?

  @@index([tenantId, status, createdAt])
  @@index([tenantId, number])
  @@map("invoicerecord")
}

/**
 * @summary Versión inmutable de una plantilla Word cargada por un tenant.
 */
model DocumentTemplate {
  id               Int                       @id @default(autoincrement())
  tenantId         Int
  documentType     String                    @default("internal_receipt") @db.VarChar(40)
  name             String                    @db.VarChar(160)
  originalFilename String                    @db.VarChar(255)
  mimeType         String                    @db.VarChar(120)
  sizeBytes        Int
  checksum         String                    @db.Char(64)
  content          Bytes                     @db.LongBlob
  version          Int                       @default(1)
  active           Boolean                   @default(false)
  isDefault        Boolean                   @default(false)
  deletedAt        DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents        InvoiceDocumentArtifact[]

  @@unique([tenantId, documentType, version])
  @@unique([tenantId, documentType, checksum])
  @@index([tenantId, documentType, active, deletedAt])
  @@map("documenttemplate")
}

/**
 * @summary Snapshot DOCX/PDF de un comprobante para no alterar documentos históricos al cambiar plantillas.
 */
model InvoiceDocumentArtifact {
  id                Int               @id @default(autoincrement())
  tenantId          Int
  invoiceId         Int               @unique
  templateId        Int?
  templateVersion   Int?
  docx              Bytes             @db.LongBlob
  pdf               Bytes?            @db.LongBlob
  pdfStatus         String            @default("unavailable") @db.VarChar(24)
  converter         String?           @db.VarChar(80)
  conversionMessage String?           @db.VarChar(500)
  createdAt         DateTime          @default(now())
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice           InvoiceRecord     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  template          DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([templateId])
  @@map("invoicedocumentartifact")
}

model InvoiceSettings {
  id             Int      @id @default(autoincrement())
  tenantId       Int      @unique
  issuerName     String?  @db.VarChar(180)
  taxId          String?  @db.VarChar(40)
  address        String?  @db.VarChar(300)
  city           String?  @db.VarChar(120)
  terms          String?  @db.Text
  templatePreset String   @default("classic") @db.VarChar(30)
  design         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("invoicesettings")
}

model IntegrationSettings {
  id               Int       @id @default(autoincrement())
  tenantId         Int
  provider         String    @db.VarChar(60)
  enabled          Boolean   @default(false)
  mode             String    @default("disabled") @db.VarChar(20)
  publicConfig     Json?
  secretConfigured Boolean   @default(false)
  status           String    @default("not_configured") @db.VarChar(30)
  lastCheckAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId, enabled, status])
  @@map("integrationsettings")
}

model SeoPage {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  path        String   @db.VarChar(220)
  title       String   @db.VarChar(180)
  description String   @db.VarChar(500)
  canonical   String?  @db.VarChar(500)
  ogImageUrl  String?  @db.VarChar(500)
  noIndex     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, path])
  @@map("seopage")
}

model RedirectRule {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  sourcePath String   @db.VarChar(300)
  targetPath String   @db.VarChar(500)
  permanent  Boolean  @default(true)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourcePath])
  @@index([tenantId, active])
  @@map("redirectrule")
}

model ErrorLog {
  id          BigInt    @id @default(autoincrement())
  tenantId    Int?
  level       String    @default("error") @db.VarChar(20)
  source      String    @db.VarChar(80)
  message     String    @db.VarChar(1000)
  path        String?   @db.VarChar(500)
  fingerprint String?   @db.VarChar(64)
  context     Json?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, resolvedAt, createdAt])
  @@index([fingerprint, createdAt])
  @@map("errorlog")
}

model PasswordResetRequest {
  id          Int       @id @default(autoincrement())
  tenantId    Int?
  userId      Int?
  emailHash   String    @db.VarChar(64)
  tokenHash   String?   @db.VarChar(64)
  status      String    @default("requested") @db.VarChar(24)
  requestedIp String?   @db.VarChar(64)
  expiresAt   DateTime?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([emailHash, createdAt])
  @@index([tokenHash])
  @@map("passwordresetrequest")
}

model PlatformPayment {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  period      String   @db.VarChar(7)
  paidAt      DateTime
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @default("ARS") @db.VarChar(3)
  method      String   @db.VarChar(40)
  reference   String?  @db.VarChar(120)
  note        String?  @db.Text
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("PlatformPaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, paidAt])
  @@index([tenantId, period])
  @@index([createdById])
  @@map("platformpayment")
}

/**
 * @summary Mapeo de pedidos externos para idempotencia y trazabilidad.
 * Permite reconocer el mismo pedido de Rappi, PedidosYa, Uber Eats, etc.
 * sin crear duplicados.
 */
model ExternalOrder {
  id                Int              @id @default(autoincrement())
  tenantId          Int
  orderId           Int
  provider          DeliveryProvider
  externalOrderId   String           @db.VarChar(120)
  externalStoreId   String?          @db.VarChar(120)
  externalReference String?          @db.VarChar(200)
  metadata          Json?
  receivedAt        DateTime         @default(now())
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order             CustomerOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, externalOrderId])
  @@index([tenantId, orderId])
  @@index([tenantId, receivedAt])
  @@map("externalorder")
}

/**
 * @summary Evento externo recibido vía webhook o polling.
 * Garantiza idempotencia: mismo provider + eventId no se procesa dos veces.
 */
model ExternalEvent {
  id              Int               @id @default(autoincrement())
  tenantId        Int
  externalOrderId String?           @db.VarChar(120)
  provider        DeliveryProvider
  eventId         String            @db.VarChar(120)
  eventType       ExternalEventType
  payload         Json
  processed       Boolean           @default(false)
  processedAt     DateTime?
  error           String?           @db.Text
  occurredAt      DateTime          @default(now())
  createdAt       DateTime          @default(now())
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, eventId])
  @@index([tenantId, processed, occurredAt])
  @@index([externalOrderId])
  @@map("externalevent")
}

/**
 * @summary Posición GPS del repartidor durante una entrega activa.
 * No guarda historial infinito: la retención se controla por aplicación.
 */
model DriverPosition {
  id              Int            @id @default(autoincrement())
  tenantId        Int
  branchId        Int?
  deliveryId      Int?
  driverId        Int
  driverProfileId Int?
  latitude        String         @db.VarChar(32)
  longitude       String         @db.VarChar(32)
  accuracy        String?        @db.VarChar(32)
  recordedAt      DateTime       @default(now())
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  delivery        OrderDelivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  driver          User           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverProfile   DriverProfile? @relation(fields: [driverProfileId], references: [id], onDelete: SetNull)

  @@index([tenantId, driverId, recordedAt])
  @@index([tenantId, branchId, recordedAt])
  @@index([deliveryId])
  @@map("driverposition")
}

/**
 * @summary Configuración de proveedores de mapas, geocoding y routing.
 * Preparado para evolucionar sin acoplar dominio a Google Maps.
 */
model DeliveryProviderConfig {
  id               Int       @id @default(autoincrement())
  tenantId         Int
  provider         String    @db.VarChar(60)
  enabled          Boolean   @default(false)
  apiKey           String?   @db.VarChar(255)
  publicConfig     Json?
  secretConfigured Boolean   @default(false)
  status           String    @default("not_configured") @db.VarChar(30)
  lastCheckAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId, enabled, status])
  @@map("deliveryproviderconfig")
}

/**
 * @summary Perfil operativo del repartidor. Complementa a User sin duplicar identidad.
 */
model DriverProfile {
  id            Int                      @id @default(autoincrement())
  tenantId      Int
  userId        Int?
  name          String                   @db.VarChar(160)
  phone         String                   @db.VarChar(60)
  status        String                   @default("AVAILABLE") @db.VarChar(24)
  active        Boolean                  @default(true)
  vehicleType   String?                  @db.VarChar(80)
  plate         String?                  @db.VarChar(20)
  color         String?                  @db.VarChar(60)
  capacity      Int?
  notes         String?                  @db.Text
  deactivatedAt DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  branches      DriverBranch[]
  incidents     DriverIncident[]
  positions     DriverPosition[]
  deliveries    OrderDelivery[]
  statusLogs    OrderDeliveryStatusLog[]

  @@index([tenantId, userId])
  @@index([tenantId, active, status])
  @@map("driverprofile")
}

/**
 * @summary Relación repartidor-sucursal habilitada.
 */
model DriverBranch {
  id        Int           @id @default(autoincrement())
  tenantId  Int
  driverId  Int
  branchId  Int
  createdAt DateTime      @default(now())
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driver    DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, driverId, branchId])
  @@index([tenantId, branchId])
  @@map("driverbranch")
}

/**
 * @summary Incidencia registrada durante una entrega.
 */
model DriverIncident {
  id           Int            @id @default(autoincrement())
  tenantId     Int
  driverId     Int
  deliveryId   Int?
  type         String         @db.VarChar(80)
  description  String         @db.Text
  reportedAt   DateTime       @default(now())
  reportedById Int?
  resolved     Boolean        @default(false)
  resolvedAt   DateTime?
  resolution   String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driver       DriverProfile  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  delivery     OrderDelivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  reportedBy   User?          @relation(fields: [reportedById], references: [id], onDelete: SetNull)

  @@index([tenantId, driverId, reportedAt])
  @@index([tenantId, deliveryId])
  @@index([tenantId, resolved, reportedAt])
  @@map("driverincident")
}

/**
 * @summary Historial de estados de una entrega. No se borra al cambiar el estado.
 * Permite reconstruir asignaciones, retiros, viajes, entregas e incidencias con timestamps reales.
 */
model OrderDeliveryStatusLog {
  id              Int            @id @default(autoincrement())
  tenantId        Int
  deliveryId      Int
  driverProfileId Int?
  status          String         @db.VarChar(24)
  previousStatus  String?        @db.VarChar(24)
  reason          String?        @db.VarChar(500)
  changedById     Int?
  changedAt       DateTime       @default(now())
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  delivery        OrderDelivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  driverProfile   DriverProfile? @relation(fields: [driverProfileId], references: [id], onDelete: SetNull)
  changedBy       User?          @relation("DeliveryStatusLogChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([tenantId, deliveryId, changedAt])
  @@index([tenantId, driverProfileId, status, changedAt])
  @@map("orderdeliverystatuslog")
}

/**
 * @summary Cuenta financiera del negocio (caja, banco, billetera o similar).
 * branchId nulo significa cuenta compartida de todo el negocio. El saldo se deriva
 * de los movimientos (balance de apertura + ingresos - egresos), nunca se almacena.
 */
model FinancialAccount {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  branchId      Int?
  name          String   @db.VarChar(160)
  code          String?  @db.VarChar(40)
  type          String   @default("caja") @db.VarChar(30)
  currency      String   @default("ARS") @db.VarChar(3)
  status        String   @default("active") @db.VarChar(20)
  openingBalance Decimal @default(0) @db.Decimal(14, 2)
  openingDate   DateTime @default(now())
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  movements     FinancialMovement[]
  transfersFrom FinancialTransfer[] @relation("FinancialTransferFrom")
  transfersTo   FinancialTransfer[] @relation("FinancialTransferTo")
  receivablePayments ReceivablePayment[]

  @@index([tenantId, branchId, status])
  @@map("financialaccount")
}

/**
 * @summary Movimiento individual del ledger financiero. Cada ingreso o egreso de una
 * cuenta genera un registro inmutable; la corrección se hace por reversión (nunca borrado).
 * transferId vincula los dos movimientos de una transferencia; reversesId apunta al
 * movimiento anulado. origin indica el flujo del sistema que lo generó.
 */
model FinancialMovement {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  branchId      Int?
  accountId     Int
  date          DateTime @default(now())
  type          String   @db.VarChar(30)
  direction     String   @db.VarChar(4)
  amount        Decimal  @db.Decimal(14, 2)
  concept       String   @db.VarChar(220)
  reference     String?  @db.VarChar(80)
  origin        String   @default("manual") @db.VarChar(40)
  referenceType String?  @db.VarChar(40)
  referenceId   Int?
  transferId    Int?
  reversesId    Int?
  createdById   Int?
  createdAt     DateTime @default(now())
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  account       FinancialAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transfer      FinancialTransfer?  @relation(fields: [transferId], references: [id], onDelete: SetNull)
  reverses      FinancialMovement?  @relation("FinancialMovementReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy    FinancialMovement[] @relation("FinancialMovementReversal")
  createdBy     User?               @relation("FinancialMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, accountId, date])
  @@index([tenantId, date])
  @@index([tenantId, type, date])
  @@index([tenantId, referenceType, referenceId])
  @@index([transferId])
  @@index([reversesId])
  @@map("financialmovement")
}

/**
 * @summary Transferencia entre cuentas del negocio. Se materializa como dos movimientos
 * (salida de origen y entrada de destino) dentro de la misma transacción de base de datos.
 */
model FinancialTransfer {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  reference     String   @unique @db.VarChar(24)
  fromAccountId Int
  toAccountId   Int
  amount        Decimal  @db.Decimal(14, 2)
  transferDate  DateTime @default(now())
  notes         String?  @db.VarChar(300)
  createdById   Int?
  createdAt     DateTime @default(now())
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromAccount   FinancialAccount    @relation("FinancialTransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount     FinancialAccount    @relation("FinancialTransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  createdBy     User?               @relation("FinancialTransferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  movements     FinancialMovement[]

  @@index([tenantId, fromAccountId, transferDate])
  @@index([tenantId, toAccountId, transferDate])
  @@map("financialtransfer")
}

/**
 * @summary Documento que genera una cuenta a cobrar a un cliente (por ejemplo una orden).
 * Los pagos se aplican contra el documento vía ReceivableAllocation; status refleja el avance.
 */
model ReceivableDocument {
  id             Int      @id @default(autoincrement())
  tenantId       Int
  branchId       Int?
  customerId     Int
  orderId        Int?
  number         String   @db.VarChar(24)
  documentDate   DateTime @default(now())
  dueDate        DateTime
  originalAmount Decimal  @db.Decimal(14, 2)
  paidAmount     Decimal  @default(0) @db.Decimal(14, 2)
  status         String   @default("open") @db.VarChar(20)
  notes          String?  @db.VarChar(300)
  createdById    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer       LoyaltyCustomer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order          CustomerOrder?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy      User?                 @relation("ReceivableDocumentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  allocations    ReceivableAllocation[]

  @@unique([tenantId, number])
  @@index([tenantId, customerId, status, dueDate])
  @@map("receivabledocument")
}

/**
 * @summary Pago recibido de un cliente en el módulo Finanzas (cuenta a cobrar).
 * Se asigna a uno o más documentos; la anulación se hace por reversión.
 */
model ReceivablePayment {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  branchId     Int?
  customerId   Int
  number       String   @db.VarChar(24)
  amount       Decimal  @db.Decimal(14, 2)
  method       String   @default("efectivo") @db.VarChar(40)
  accountId    Int?
  paidAt       DateTime @default(now())
  notes        String?  @db.VarChar(240)
  status       String   @default("confirmed") @db.VarChar(20)
  createdById  Int?
  createdAt    DateTime @default(now())
  reversedAt   DateTime?
  reversedById Int?
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer     LoyaltyCustomer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  account      FinancialAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy    User?                 @relation("ReceivablePaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reversedBy   User?                 @relation("ReceivablePaymentReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)
  allocations  ReceivableAllocation[]

  @@unique([tenantId, number])
  @@index([tenantId, customerId, paidAt])
  @@map("receivablepayment")
}

/**
 * @summary Asignación de un pago a un documento de cuenta a cobrar. Permite pagos
 * parciales, sobre-aplicación (saldo a favor) y distribución entre varios documentos.
 */
model ReceivableAllocation {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  paymentId    Int
  documentId   Int
  amount       Decimal  @db.Decimal(14, 2)
  status       String   @default("active") @db.VarChar(20)
  reversedAt   DateTime?
  reversedById Int?
  createdAt    DateTime @default(now())
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment      ReceivablePayment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  document     ReceivableDocument    @relation(fields: [documentId], references: [id], onDelete: Restrict)
  reversedBy   User?                 @relation("ReceivableAllocationReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([paymentId])
  @@map("receivableallocation")
}
