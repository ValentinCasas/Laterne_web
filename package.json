{
  "name": "laterne-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "npm run build:css && nodemon --watch src --watch views src/index.js",
    "build": "npm run build:css && npm run check:views",
    "build:css": "tailwindcss -i ./src/styles/app.css -o ./public/css/app.css --minify",
    "check:views": "node scripts/validate-views.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.4",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-fileupload": "^1.4.3",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "morgan": "~1.9.1",
    "mysql2": "^3.22.3",
    "pug": "^3.0.2",
    "sequelize": "^6.37.8",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "tailwindcss": "^3.3.5"
  }
}
