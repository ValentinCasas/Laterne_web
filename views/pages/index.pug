extends ../layouts/base

block title
  | Laterne · Cerveza artesanal

block append styles
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css')
  link(rel='stylesheet' href='https://unpkg.com/leaflet@1.7.1/dist/leaflet.css')
  link(rel='stylesheet' href='/css/pages/landing.css')

block body
  - const business = BusinessInfo || {}
  - const whatsappNumber = String(business.phoneNumber || '').replace(/\D/g, '')
  a(href='https://wa.me/' + whatsappNumber aria-label='Enviar mensaje por WhatsApp')
    svg.whatsapp-ico(viewBox='0 0 32 32' aria-hidden='true')
      path(d='M19.11 17.205c-.372 0-1.088 1.39-1.518 1.39a.63.63 0 0 1-.315-.1c-.802-.402-1.504-.817-2.163-1.447-.545-.516-1.146-1.29-1.46-1.963a.426.426 0 0 1-.073-.215c0-.33.99-.945.99-1.49 0-.143-.73-2.09-.832-2.335-.143-.372-.214-.487-.6-.487-.187 0-.36-.043-.53-.043-.302 0-.53.115-.746.315-.688.645-1.032 1.318-1.06 2.264v.114c-.015.99.472 1.977 1.017 2.78 1.23 1.82 2.506 3.41 4.554 4.34.616.287 2.035.888 2.722.888.817 0 2.15-.515 2.478-1.318.13-.33.244-.73.244-1.088 0-.058 0-.144-.03-.215-.1-.172-2.434-1.39-2.678-1.39zm-2.908 7.593c-1.747 0-3.48-.53-4.942-1.49L7.793 24.41l1.132-3.337a8.955 8.955 0 0 1-1.72-5.272c0-4.955 4.04-8.995 8.997-8.995S25.2 10.845 25.2 15.8c0 4.958-4.04 8.998-8.998 8.998zm0-19.798c-5.96 0-10.8 4.842-10.8 10.8 0 1.964.53 3.898 1.546 5.574L5 27.176l5.974-1.92a10.807 10.807 0 0 0 16.03-9.455c0-5.958-4.842-10.8-10.802-10.8z' fill-rule='evenodd')

  header
    nav.navbar.fixed.inset-x-0.top-0.z-50.shadow-xl(aria-label='Navegación principal' class='bg-black/95')
      .mx-auto.flex.max-w-7xl.flex-wrap.items-center.justify-between.px-4.py-3
        a.navbar-brand.brand(href='/' aria-label='Laterne, inicio')
          span.brand-highlight Laterne
          span.brand-highlight.text-white &
          span.point .
        button.rounded-lg.border.p-2.text-white(type='button' data-menu-toggle aria-controls='landing-navigation' aria-expanded='false' class='border-white/30 md:hidden')
          span.sr-only Abrir navegación
          svg.h-6.w-6(viewBox='0 0 24 24' fill='none' stroke='currentColor' aria-hidden='true')
            path(stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M4 6h16M4 12h16M4 18h16')
        #landing-navigation.hidden.w-full.flex-col.gap-1.pt-4(class='md:flex md:w-auto md:flex-row md:pt-0')
          a.rounded-md.px-3.py-2.font-semibold.text-white(href='/card_virtual' class='hover:text-laterne-pink') Carta
          a.rounded-md.px-3.py-2.font-semibold.text-white(href='#eventos' class='hover:text-laterne-pink') Eventos
          a.rounded-md.px-3.py-2.font-semibold.text-white(href='#redes' class='hover:text-laterne-pink') Redes
          a.rounded-md.px-3.py-2.font-semibold.text-white(href='#openingHour' class='hover:text-laterne-pink') Horarios

  section.father
    img.banner.h-full.w-full.object-cover(src='/images/banners/new_banner2_750.jpg' alt='Cervezas Laterne')
    .son
      .wrapper
        h1 Laterne es
        .words
          span Birra
          span Amigos
          span Familia
      .pbox
        p Hace muchos años que Laterne es sinónimo de birra, amistad, momentos compartidos y buena cerveza artesanal. Los cambios nos dejaron en un lugar más simple, como con quienes elegimos compartir lo que hacemos.

  section.container-eventos.px-4.py-16(aria-labelledby='eventos')
    h2#eventos.text-center.text-5xl.font-bold Eventos
    .contenedor-cards.mx-auto.mt-10.max-w-6xl.space-y-5
      if Events && Events.length
        each event in Events
          - const eventDate = event.date ? new Date(event.date).toLocaleDateString('es-AR', { timeZone: 'UTC' }) : 'Sin fecha'
          - const eventTime = event.time ? event.time.substring(0, 5) : 'Sin hora'
          article.card-evento.flex.flex-col.items-start.justify-between.gap-4.p-6(class='md:flex-row md:items-center')
            time.text-2xl.font-bold(datetime=event.date || '')= eventDate
            .flex.flex-wrap.items-center.gap-3
              span= event.location
              strong.artist= event.name
              time(datetime=event.time || '')= eventTime
              if event.imageUrl
                button.rounded-full.p-2(type='button' data-event-image='/images/images_event/' + event.imageUrl aria-label='Ver imagen de ' + event.name class='bg-black/10')
                  svg.h-6.w-6(viewBox='0 0 24 24' fill='none' stroke='currentColor' aria-hidden='true')
                    path(stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M3 16.5V6.75A2.25 2.25 0 0 1 5.25 4.5h13.5A2.25 2.25 0 0 1 21 6.75v9.75m-18 0v.75a2.25 2.25 0 0 0 2.25 2.25h13.5A2.25 2.25 0 0 0 21 17.25v-.75M3 16.5l5.47-5.47a1.5 1.5 0 0 1 2.12 0l1.91 1.91 2.72-2.72a1.5 1.5 0 0 1 2.12 0L21 13.88')
      else
        article.card-evento.p-6
          p.text-2xl.font-bold Próximamente…

  #modal.modal-container(role='dialog' aria-modal='true' aria-label='Imagen del evento')
    .modal-content
      button.close-btn(type='button' data-event-modal-close aria-label='Cerrar imagen') ×
      img#modalImage(alt='Imagen ampliada')

  section.swiper-container.container-beers(aria-labelledby='beers-title')
    h2#beers-title.text-center.text-4xl.font-bold Nuestras cervezas
    .swiper-wrapper
      each image in ['neipa-tapa.png', 'amber-tapa.png', 'apa-tapa.png', 'american-amber-tapa.png']
        .swiper-slide
          img(src='/images/banners/' + image alt='Cerveza Laterne')

  section.intro-section.bg-black(aria-label='Conocé Laterne')
    .container
      .grid
        .column-xs-12
          ul.slider
            each slide, index in [{ title: 'Laterne', text: 'Hace muchos años que Laterne es sinónimo de birra, amistad, momentos compartidos y buena cerveza artesanal.' }, { title: 'Nuestra casa', text: 'Un espacio para encontrarse, compartir algo rico y disfrutar una cerveza artesanal con identidad propia.' }, { title: 'Momentos', text: 'Laterne es birra, música, amigos, familia y esas noches que se vuelven parte de una historia compartida.' }]
              li.slider-item(class=index === 0 ? 'active' : '')
                .grid.vertical
                  .column-xs-12.column-md-2.hide-mobile
                    .intro
                      h2.title
                        span.underline= slide.title
                  .column-xs-12.column-md-10
                    .image-holder
                      img.img-carrousel(src='/images/banners/laterne2.jpg' alt='Interior de Laterne')
                    .grid
                      .column-xs-12.column-md-9
                        .intro.show-mobile
                          h2.title
                            span.underline= slide.title
                        p.description.text-white= slide.text
          .controls
            button.previous(type='button')
              span.sr-only Anterior
              span.icon.arrow-left(aria-hidden='true')
            button.next(type='button')
              span.sr-only Siguiente
              span.icon.arrow-right(aria-hidden='true')

  section.container-testimonial(aria-labelledby='testimonials-title')
    .testimonial
      h2#testimonials-title.text-center.text-4xl.font-bold.text-white Esto es lo que opina la gente de nosotros
    .testimonial-reel.testimonial-swiper.swiper
      .swiper-wrapper
        each testimonial, index in Testimonials
          - const avatar = ImagesUrls && ImagesUrls.length ? '/images/avatars_defect/' + ImagesUrls[index % ImagesUrls.length] : '/images/image_defect/avatar_profile_default.png'
          .swiper-slide
            .box
              figure.image
                img(src=avatar alt='Cliente de Laterne')
              .test-component
                .test-title
                  time= testimonial.date
                .test-content
                  p= testimonial.description
      .swiper-pagination
    form#form-testimonial.form.mx-auto.mt-8.flex.max-w-2xl.gap-3
      label.sr-only(for='testimonial-description') Tu opinión
      input#testimonial-description.form-input.flex-1(type='text' name='description' placeholder='Dejanos una opinión anónima' maxlength='500' required)
      button.button-primary(type='submit') Enviar

  section.contain-map(aria-label='Ubicación de Laterne')
    #map

  section#openingHour.bg-black.px-4.py-16.text-center(aria-labelledby='hours-title')
    h2#hours-title.text-4xl.font-bold.text-white Horarios
    .mx-auto.mt-8.max-w-4xl.space-y-6
      each hours in GroupedOpeningHours
        if hours.morningStartTime || hours.morningEndTime || hours.eveningStartTime || hours.eveningEndTime
          article
            if hours.days
              h3.text-xl.font-bold.uppercase.text-white= hours.days.join(', ')
            p.mt-2.text-laterne-pink
              | #{hours.morningStartTime ? 'De ' + hours.morningStartTime.substring(0, 5) + ' a ' : ''}
              | #{hours.morningEndTime ? hours.morningEndTime.substring(0, 5) + ' y ' : ''}
              | #{hours.eveningStartTime ? 'de ' + hours.eveningStartTime.substring(0, 5) + ' a ' : ''}
              | #{hours.eveningEndTime ? hours.eveningEndTime.substring(0, 5) : 'cierre'}

  footer#redes.footer-dark
    .mx-auto.grid.max-w-7xl.gap-8.px-6.py-12(class='sm:grid-cols-2 lg:grid-cols-4')
      .item
        h2 Soporte
        ul.mt-3.space-y-2
          li= business.address
          li
            a(href='mailto:' + (business.email || ''))= business.email
          li
            a(href='tel:' + (business.phoneNumber || ''))= business.phoneNumber
      .item
        h2 Nosotros
        ul.mt-3
          li
            a(href='/auth/view-login') Soy empleado
      .item
        h2 Medios de pago
        ul.mt-3.space-y-2
          li Mercado Pago
          li Visa
          li Mastercard
      .item.social.flex.items-start.gap-3
        a(href=business.instagramUrl aria-label='Instagram' rel='noopener noreferrer' target='_blank') Instagram
        a(href=business.facebookUrl aria-label='Facebook' rel='noopener noreferrer' target='_blank') Facebook
    p.copyright.pb-8 Laterne & . © #{new Date().getFullYear()} · Valen Casas & Gino Paoletti

block append scripts
  script(src='https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js' defer)
  script(src='https://unpkg.com/leaflet@1.7.1/dist/leaflet.js')
  script(src='/js/navigation.js' defer)
  script(src='/js/site/carousels.js' defer)
  script(src='/js/site/landing.js' defer)
  script(src='/js/site/testimonial-carousel.js' defer)
