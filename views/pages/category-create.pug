extends ../layouts/admin
include ../mixins/forms

block title
  | Categorías · Laterne

block append styles
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css')
  link(rel='stylesheet' href='/css/pages/categories.css')

block content
  .page-shell.grid.gap-8(class='lg:grid-cols-2')
    form#form_category.panel.h-fit
      h1.text-2xl.font-bold Nueva categoría
      p.mt-2.text-sm.text-gray-600 Creá una categoría y elegí el ícono que la representa.

      .mt-8.space-y-5
        +field('Nombre', 'name', 'text', '')(required maxlength='100')
        +textareaField('Descripción', 'description', '')(required maxlength='500')

        fieldset
          legend.form-label.mb-2 Ícono
          .swiper-container-categories.overflow-hidden
            .swiper-wrapper
              each image in Images
                .swiper-slide.flex.justify-center.rounded-xl.border.border-gray-200
                  button.selectable-image.w-full.p-3(type='button' data-name=image.name aria-label='Usar ' + image.name)
                    img.mx-auto.h-20.w-20.object-contain(src=image.path alt='')
          input#selectedImage(type='hidden' name='selectedImage' required)

      .mt-8.flex.justify-end
        button.button-primary(type='submit') Crear categoría

    section(aria-labelledby='categories-title')
      h2#categories-title.text-2xl.font-bold Categorías
      label.sr-only(for='search-input') Buscar categorías
      input#search-input.form-input.mt-4(type='search' placeholder='Buscar categorías…')

      #container-categories.mt-6.space-y-5.overflow-auto.pr-2(class='max-h-[70vh]')
        each category in Categories
          article.card.panel.relative.flex.gap-4.overflow-hidden.pb-16(id='card-' + category.id)
            img.h-28.w-28.shrink-0.object-contain(src='/images/images_categories/' + category.imageUrl alt='Ícono de ' + category.name)
            div
              h3.text-lg.font-bold= category.name
              p.mt-2.text-sm.text-gray-600= category.description
            .absolute.inset-x-0.bottom-0.grid.grid-cols-2.border-t.border-gray-200
              a.p-3.text-center.text-sm.font-semibold.text-gray-700.transition(href='/category/view-edit-category/' + category.id class='hover:bg-gray-50') Editar
              button.delete-category.border-l.border-gray-200.p-3.text-sm.font-semibold.text-red-600.transition(type='button' data-category-id=category.id class='hover:bg-red-50') Eliminar

block append scripts
  script(src='https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js' defer)
  script(src='/js/site/carousels.js' defer)
  script(src='/js/admin/collection-tools.js' defer)
  script(src='/js/admin/category-create.js' defer)
