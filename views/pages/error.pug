extends ../layouts/admin

block title
  | #{statusCode || 500} · Laterne

block content
  section.page-shell.flex.min-h-96.items-center.justify-center
    .max-w-2xl.text-center
      p.font-display.text-6xl.text-laterne-pink= statusCode || 500
      h1.mt-4.text-3xl.font-bold.tracking-tight.text-gray-900= title || 'Ocurrió un error'
      p.mt-3.text-gray-600= message || 'No pudimos completar la solicitud.'
      a.button-primary.mt-8(href='/') Volver al inicio
