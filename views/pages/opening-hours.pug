extends ../layouts/admin

block title
  | Horarios · Laterne

block append styles
  link(rel='stylesheet' href='/css/pages/opening-hours.css')

block content
  - const dayConfigs = [{ label: 'Lunes', aliases: ['Lunes'], prefix: 'lun' }, { label: 'Martes', aliases: ['Martes'], prefix: 'mar' }, { label: 'Miércoles', aliases: ['Miércoles', 'Miercoles'], prefix: 'mier' }, { label: 'Jueves', aliases: ['Jueves'], prefix: 'jue' }, { label: 'Viernes', aliases: ['Viernes'], prefix: 'vie' }, { label: 'Sábado', aliases: ['Sábado', 'Sabado'], prefix: 'sab' }, { label: 'Domingo', aliases: ['Domingo'], prefix: 'dom' }]
  .page-shell
    form#form-openingHour.panel.overflow-hidden
      header
        h1.text-2xl.font-bold Horarios de atención
        p.mt-2.text-sm.text-gray-600 Definí los turnos de mañana y noche para cada día.

      .mt-8.overflow-x-auto
        table.w-full.border-separate.border-spacing-y-2(class='min-w-[760px]')
          thead
            tr.text-left.text-xs.font-semibold.uppercase.tracking-wide.text-gray-500
              th.px-3.py-2 Día
              th.px-3.py-2 Mañana abre
              th.px-3.py-2 Mañana cierra
              th.px-3.py-2 Noche abre
              th.px-3.py-2 Noche cierra
              th.px-3.py-2
          tbody
            each day in dayConfigs
              - const hour = OpeningHour.find((item) => day.aliases.includes(item.dayOfWeek)) || {}
              tr.bg-gray-50
                th.rounded-l-lg.px-3.py-3.text-left.text-sm.font-semibold= day.label
                td.px-3.py-3
                  input.form-input(type='time' name=day.prefix + 'MorningStartTime' value=hour.morningStartTime || '')
                td.px-3.py-3
                  input.form-input(type='time' name=day.prefix + 'MorningEndTime' value=hour.morningEndTime || '')
                td.px-3.py-3
                  input.form-input(type='time' name=day.prefix + 'EveningStartTime' value=hour.eveningStartTime || '')
                td.px-3.py-3
                  input.form-input(type='time' name=day.prefix + 'EveningEndTime' value=hour.eveningEndTime || '')
                td.rounded-r-lg.px-3.py-3.text-right
                  if hour.id
                    button.delete-link.text-sm.font-semibold.text-red-600(type='button' data-id=hour.id) Limpiar

      .mt-8.flex.justify-end
        button.button-primary(type='submit') Guardar horarios

block append scripts
  script(src='/js/admin/opening-hours.js' defer)
