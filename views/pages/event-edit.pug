extends ../layouts/admin
include ../mixins/forms

block title
  | Editar evento · Laterne

block append styles
  link(rel='stylesheet' href='/css/pages/events.css')
  link(rel='stylesheet' href='/css/components/file-upload.css')

block content
  - const dateValue = Event.date ? new Date(Event.date).toISOString().substring(0, 10) : ''
  - const timeValue = Event.time ? Event.time.substring(0, 5) : ''
  .page-shell.grid.gap-8(class='lg:grid-cols-2')
    form#form_edit_event.panel.h-fit
      input(type='hidden' name='id' value=Event.id)
      h1.text-2xl.font-bold Editar evento

      .mt-8.space-y-5
        +field('Nombre', 'name', 'text', Event.name)(required maxlength='120')
        +textareaField('Descripción', 'description', Event.description)(maxlength='500')
        .grid.gap-5(class='sm:grid-cols-2')
          +field('Fecha', 'date', 'date', dateValue)(required)
          +field('Hora', 'time', 'time', timeValue)(required)
        +field('Dirección', 'location', 'text', Event.location)(required maxlength='200')
        +fileUpload('Reemplazar imagen')

      .mt-8.flex.justify-end
        button.button-primary(type='submit') Guardar cambios

    article.card.panel.flex.gap-5(id='card-' + Event.id)
      if Event.imageUrl
        img#event-image.h-44.w-44.rounded-xl.object-cover(src='/images/images_event/' + Event.imageUrl alt='Imagen de ' + Event.name)
      div.flex-1(id='card-child-' + Event.id)
        h2#event-name.text-xl.font-bold= Event.name
        p#event-description.mt-2.text-gray-600= Event.description
        dl.mt-4.space-y-2.text-sm.text-gray-600
          div.flex.gap-2
            dt.font-semibold Fecha:
            dd#event-date= Event.date ? new Date(Event.date).toLocaleDateString('es-AR', { timeZone: 'UTC' }) : 'Sin fecha'
          div.flex.gap-2
            dt.font-semibold Hora:
            dd#event-time= timeValue || 'Sin hora'
          div.flex.gap-2
            dt.font-semibold Lugar:
            dd#event-location= Event.location

block append scripts
  script(src='/js/admin/file-upload.js' defer)
  script(src='/js/admin/event-edit.js' defer)
