extends ../layouts/admin
include ../mixins/forms

block title
  | Editar usuario · Laterne

block append styles
  link(rel='stylesheet' href='/css/pages/profile.css')
  link(rel='stylesheet' href='/css/components/file-upload.css')

block content
  .page-shell
    form#form-update-profile.panel.mx-auto.max-w-3xl(data-endpoint='/auth/update-user-admin/' + User.id data-method='PUT')
      input(type='hidden' name='id' value=User.id)
      header
        h1.text-2xl.font-bold Editar usuario
        p.mt-2.text-sm.text-gray-600 Administrá los datos de #{User.name}.

      .mt-8.grid.gap-8(class='md:grid-cols-[160px_1fr]')
        img.h-36.w-36.rounded-2xl.border.border-gray-200.object-cover(src=User.imageUrl === 'avatar_profile_default.png' ? '/images/image_defect/avatar_profile_default.png' : '/images/images_profile/' + User.imageUrl alt='Foto de perfil de ' + User.name)
        .space-y-5
          +field('Nombre', 'name', 'text', User.name)(required autocomplete='name')
          +field('Email', 'email', 'email', User.email)(required autocomplete='email')
          +fileUpload('Cambiar foto')

      .mt-8.grid.gap-5.border-t.border-gray-200.pt-8(class='sm:grid-cols-2')
        +field('Contraseña actual', 'currentPassword', 'password', '')(autocomplete='current-password')
        +field('Nueva contraseña', 'newPassword', 'password', '')(autocomplete='new-password' minlength='8')

      .mt-8.flex.justify-end
        button.button-primary(type='submit') Guardar cambios

block append scripts
  script(src='/js/admin/file-upload.js' defer)
  script(src='/js/admin/profile-edit.js' defer)
