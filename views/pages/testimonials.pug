extends ../layouts/admin

block title
  | Opiniones · Laterne

block append styles
  link(rel='stylesheet' href='/css/pages/testimonials.css')

block content
  .page-shell
    header
      h1.text-3xl.font-bold Opiniones
      p.mt-2.text-gray-600 Revisá, aprobá o eliminá los comentarios del sitio.

    .mt-6.flex.flex-wrap.gap-4.text-sm
      span.inline-flex.items-center.gap-2
        span.h-3.w-3.rounded-full.bg-emerald-500
        | Aceptada
      span.inline-flex.items-center.gap-2
        span.h-3.w-3.rounded-full.bg-amber-400
        | En espera

    .mt-8.grid.gap-8(class='lg:grid-cols-2')
      section(aria-labelledby='pending-title')
        h2#pending-title.text-xl.font-bold En espera
        .project-tasks.mt-4
          each testimonial in TestimonialsNoAcepted
            article.task(data-testimonial-card draggable='true' id='testimonial-' + testimonial.id)
              button.btn-borrar(type='button' data-delete-testimonial=testimonial.id aria-label='Eliminar opinión')
                svg.icon(viewBox='0 0 15 17.5' aria-hidden='true')
                  path(d='M12.5 2.5h-5V1.25h5V2.5ZM2.5 3.75h15V5h-1.25v12.5A1.25 1.25 0 0 1 15 18.75H5a1.25 1.25 0 0 1-1.25-1.25V5H2.5V3.75ZM5 5v12.5h10V5H5Zm2.5 2.5h1.25V15H7.5V7.5Zm3.75 0h1.25V15h-1.25V7.5Z')
              p(id='description-' + testimonial.id)= testimonial.description
              .task__stats
                time= testimonial.date
                span.task__owner.is-pending(id='task_owner-' + testimonial.id aria-label='En espera')
                button.info.button-secondary(type='button' data-edit-testimonial data-id=testimonial.id data-description=testimonial.description data-state=testimonial.state) Editar

      section(aria-labelledby='accepted-title')
        h2#accepted-title.text-xl.font-bold Aceptadas
        .project-tasks.mt-4
          each testimonial in TestimonialsAcepted
            article.task(data-testimonial-card draggable='true' id='testimonial-' + testimonial.id)
              button.btn-borrar(type='button' data-delete-testimonial=testimonial.id aria-label='Eliminar opinión')
                svg.icon(viewBox='0 0 15 17.5' aria-hidden='true')
                  path(d='M12.5 2.5h-5V1.25h5V2.5ZM2.5 3.75h15V5h-1.25v12.5A1.25 1.25 0 0 1 15 18.75H5a1.25 1.25 0 0 1-1.25-1.25V5H2.5V3.75ZM5 5v12.5h10V5H5Zm2.5 2.5h1.25V15H7.5V7.5Zm3.75 0h1.25V15h-1.25V7.5Z')
              p(id='description-' + testimonial.id)= testimonial.description
              .task__stats
                time= testimonial.date
                span.task__owner.is-accepted(id='task_owner-' + testimonial.id aria-label='Aceptada')
                button.info.button-secondary(type='button' data-edit-testimonial data-id=testimonial.id data-description=testimonial.description data-state=testimonial.state) Editar

  #myModal.hidden.fixed.inset-0.z-50.flex.items-center.justify-center.p-4(role='dialog' aria-modal='true' aria-labelledby='testimonial-modal-title' class='bg-gray-950/70')
    .w-full.max-w-lg.rounded-2xl.bg-white.p-6.shadow-2xl
      h2#testimonial-modal-title.text-xl.font-bold Actualizar opinión
      form#form_testimonial.mt-6(action='/testimonial/update-testimonial' method='post')
        .form-field
          label.form-label(for='modal-description') Descripción
          textarea#modal-description.form-input(name='description' rows='4' required)
        label.mt-5.flex.items-center.gap-3.text-sm.font-medium.text-gray-700(for='modal-state')
          input#modal-state.h-5.w-5.rounded.border-gray-300.text-laterne-pink(type='checkbox' name='state')
          | Publicar opinión
        input#modal-id(type='hidden' name='id')
        .mt-6.flex.justify-end.gap-3
          button#closeModalButton.button-secondary(type='button') Cancelar
          button.button-primary(type='submit') Guardar

block append scripts
  script(src='/js/admin/testimonial-board.js' defer)
  script(src='/js/admin/testimonial-actions.js' defer)
