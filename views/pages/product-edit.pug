extends ../layouts/admin
include ../mixins/forms

block title
  | Editar producto · Laterne

block append styles
  link(rel='stylesheet' href='/css/pages/products.css')
  link(rel='stylesheet' href='/css/components/file-upload.css')

block content
  .page-shell.grid.gap-8(class='lg:grid-cols-2')
    form#form_edit_product.panel.h-fit
      input(type='hidden' name='id' value=Product.id)
      h1.text-2xl.font-bold Editar producto

      .mt-8.space-y-5
        +field('Nombre', 'name', 'text', Product.name)(required maxlength='120')
        +textareaField('Descripción', 'description', Product.description)(required maxlength='500')
        +field('Precio', 'price', 'number', Product.price)(required min='0' step='0.01')

        .form-field
          label.form-label(for='availavility') Disponibilidad
          select#availavility.form-input(name='availavility' required)
            option(value='disponible' selected=Product.availavility === 'disponible') Disponible
            option(value='agotado' selected=Product.availavility === 'agotado') Agotado

        fieldset
          legend.form-label.mb-2 Categorías
          .max-h-64.space-y-2.overflow-auto.rounded-xl.border.border-gray-200.p-3
            each category in Categories
              label.flex.cursor-pointer.items-center.gap-4.rounded-lg.p-3.transition(for='category-' + category.id class='hover:bg-gray-50')
                input.hidden.peer(type='checkbox' name='categoryIds' id='category-' + category.id value=category.id checked=ProductCategory.some((item) => item.categoryId === category.id))
                img.h-12.w-12.object-contain(src='/images/images_categories/' + category.imageUrl alt='')
                span.flex-1
                  strong.block= category.name
                  small.text-gray-500= category.description
                span.hidden.rounded-full.bg-pink-100.px-2.py-1.text-xs.font-semibold.text-laterne-pink(class='peer-checked:inline') Seleccionada

        +fileUpload('Reemplazar imagen')

      .mt-8.flex.justify-end
        button.button-primary(type='submit') Guardar cambios

    article.card.panel(id='card-' + Product.id)
      img#product-image.h-64.w-full.object-contain(src=Product.imageUrl === 'product_default.png' ? '/images/image_defect/product_default.png' : '/images/images_product/' + Product.imageUrl alt='Imagen de ' + Product.name)
      h2#product-name.mt-5.text-2xl.font-bold= Product.name
      p#product-description.mt-2.text-gray-600= Product.description
      .mt-4.flex.items-center.justify-between
        span#product-availavility.rounded-full.bg-gray-100.px-3.py-1.text-sm= Product.availavility
        strong#product-price.text-xl $ #{Product.price}
      .mt-6
        h3.text-sm.font-bold.uppercase.tracking-wide.text-gray-500 Categorías
        #product-categories.mt-3.flex.flex-wrap.gap-2
          each item in ProductCategory
            span.rounded-full.bg-pink-50.px-3.py-1.text-sm.font-semibold.text-laterne-pink= item.Category.name

block append scripts
  script(src='/js/admin/file-upload.js' defer)
  script(src='/js/admin/product-edit.js' defer)
