extends ../layouts/admin

block title
  | Iniciar sesión · Laterne

block content
  section.grid(class='min-h-[calc(100vh-68px)] lg:grid-cols-2')
    .flex.items-center.justify-center.p-6(class='sm:p-12')
      form#form_login.panel.w-full.max-w-md(action='/auth/login' method='post')
        h1.text-3xl.font-bold.text-gray-950 Iniciar sesión
        p.mt-2.text-sm.text-gray-600 Acceso exclusivo para el equipo de Laterne.

        .mt-8.space-y-5
          .form-field
            label.form-label(for='email') Email
            input#email.form-input(type='email' name='email' autocomplete='email' required)
          .form-field
            label.form-label(for='password') Contraseña
            input#password.form-input(type='password' name='password' autocomplete='current-password' required)

        button.button-primary.mt-8.w-full(type='submit') Ingresar

    .relative.hidden.overflow-hidden.bg-gray-950(class='lg:block')
      img.absolute.inset-0.h-full.w-full.object-cover.opacity-75(src='/images/banners/banner-carta.png' alt='Cervezas artesanales Laterne')

block append scripts
  script(src='/js/admin/login.js' defer)
