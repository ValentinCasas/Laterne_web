extends ../layouts/admin
include ../mixins/forms

block title
  | Productos · Laterne

block append styles
  link(rel='stylesheet' href='/css/pages/products.css')
  link(rel='stylesheet' href='/css/components/file-upload.css')

block content
  .page-shell.grid.gap-8(class='lg:grid-cols-2')
    form#form_product.panel.h-fit
      h1.text-2xl.font-bold Nuevo producto
      p.mt-2.text-sm.text-gray-600 Agregá un producto a la carta de Laterne.

      .mt-8.space-y-5
        +field('Nombre', 'name', 'text', '')(required maxlength='120')
        +textareaField('Descripción', 'description', '')(required maxlength='500')
        +field('Precio', 'price', 'number', '')(required min='0' step='0.01')

        .form-field
          label.form-label(for='availavility') Disponibilidad
          select#availavility.form-input(name='availavility' required)
            option(value='disponible') Disponible
            option(value='agotado') Agotado

        if Categories.length
          .form-field
            label.form-label(for='categoryId') Categoría
            select#categoryId.form-input(name='categoryId' required)
              each category in Categories
                option(value=category.id)= category.name
        else
          p.rounded-lg.bg-amber-50.p-3.text-sm.text-amber-800 Creá una categoría antes de publicar el producto.

        +fileUpload('Imagen del producto')

      .mt-8.flex.justify-end
        button.button-primary(type='submit' disabled=!Categories.length) Crear producto

    section(aria-labelledby='products-title')
      h2#products-title.text-2xl.font-bold Productos
      .sticky.top-2.z-10.mt-4.space-y-3.rounded-xl.border.border-gray-200.bg-white.p-4.shadow-sm
        label.sr-only(for='search-input') Buscar productos
        input#search-input.form-input(type='search' placeholder='Buscar productos…')
        form#form-percentaje.grid.gap-3(class='sm:grid-cols-[120px_1fr_auto]')
          label.sr-only(for='operation') Operación
          select#operation.form-input(name='operation')
            option(value='sum') Aumentar
            option(value='res') Reducir
          label.sr-only(for='percentage') Porcentaje
          input#percentage.form-input(type='number' name='percentage' min='0' step='0.01' placeholder='Porcentaje' required)
          button.button-secondary(type='submit') Aplicar
        button#btn-select-products.button-secondary.w-full(type='button') Seleccionar Todo

      #container-products.mt-6.space-y-5.overflow-auto.pr-2(class='max-h-[75vh]')
        each product in Products
          article.card.panel.relative.overflow-hidden.pb-16(id='card-' + product.id)
            label.absolute.right-4.top-4.flex.cursor-pointer.items-center.gap-2.text-sm.font-medium
              input.each-product-checkbox.h-5.w-5.rounded.border-gray-300.text-laterne-pink(type='checkbox' id='cbx-' + product.id name='cbx-' + product.id)
              span Seleccionar
            img.h-48.w-full.object-contain(src=product.imageUrl === 'product_default.png' ? '/images/image_defect/product_default.png' : '/images/images_product/' + product.imageUrl alt='Imagen de ' + product.name)
            .mt-4
              h3.text-lg.font-bold= product.name
              details.mt-3.rounded-lg.border.border-gray-200
                summary.cursor-pointer.p-3.font-medium Descripción
                p.border-t.border-gray-200.p-3.text-sm.text-gray-600= product.description
              .mt-3.flex.items-center.justify-between
                span.rounded-full.bg-gray-100.px-3.py-1.text-sm= product.availavility
                strong.price-element.text-lg $ #{product.price}
            .absolute.inset-x-0.bottom-0.grid.grid-cols-2.border-t.border-gray-200
              a.p-3.text-center.text-sm.font-semibold.text-gray-700(href='/product/view-edit-product/' + product.id class='hover:bg-gray-50') Editar
              button.delete-product.border-l.border-gray-200.p-3.text-sm.font-semibold.text-red-600(type='button' data-product-id=product.id class='hover:bg-red-50') Eliminar

block append scripts
  script(src='/js/admin/file-upload.js' defer)
  script(src='/js/admin/collection-tools.js' defer)
  script(src='/js/admin/product-create.js' defer)
