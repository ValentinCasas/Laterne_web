extends ../layouts/admin

block title
  | Resumen · Laterne

block content
  section.relative.overflow-hidden.bg-gray-950
    img.absolute.inset-0.h-full.w-full.object-cover.opacity-20(src='https://images.unsplash.com/photo-1521737852567-6949f3f9f2b5?auto=format&fit=crop&w=1800&q=80' alt='Equipo trabajando en conjunto')
    .page-shell.relative.py-20
      p.text-sm.font-semibold.uppercase.tracking-widest.text-pink-300 Panel de administración
      h1.mt-3.max-w-3xl.text-4xl.font-bold.tracking-tight.text-white Resumen del negocio
      p.mt-4.max-w-3xl.text-lg.text-gray-300 Consultá de un vistazo el contenido disponible en Laterne.

      dl.mt-12.grid.gap-5(class='sm:grid-cols-2 lg:grid-cols-5')
        each metric in [{ label: 'Productos', value: productCount }, { label: 'Categorías', value: categoryCount }, { label: 'Usuarios', value: userCount }, { label: 'Opiniones', value: testimonialCount }, { label: 'Eventos', value: eventCount }]
          .rounded-2xl.border.p-5.backdrop-blur(class='border-white/10 bg-white/10')
            dt.text-sm.font-medium.text-gray-300= metric.label
            dd.mt-2.text-3xl.font-bold.text-white= metric.value
