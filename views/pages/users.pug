extends ../layouts/admin
include ../mixins/forms

block title
  | Usuarios · Laterne

block append styles
  link(rel='stylesheet' href='/css/components/file-upload.css')

block content
  .page-shell.space-y-10
    form#form_user.panel.mx-auto.max-w-2xl
      header
        h1.text-2xl.font-bold Crear usuario
        p.mt-2.text-sm.text-gray-600 Agregá una persona al equipo y asignale un rol.

      .mt-8.grid.gap-5(class='sm:grid-cols-2')
        +field('Nombre', 'name', 'text', '')(required autocomplete='name')
        +field('Email', 'email', 'email', '')(required autocomplete='email')
        +field('Contraseña', 'password', 'password', '')(required autocomplete='new-password' minlength='8')
        .form-field
          label.form-label(for='role') Rol
          select#role.form-input(name='role' required)
            option(value='1') Administrador
            option(value='2') Empleado

      .mt-5
        +fileUpload('Foto de perfil')

      .mt-8.flex.justify-end
        button.button-primary(type='submit') Crear usuario

    section(aria-labelledby='team-title')
      h2#team-title.text-3xl.font-bold Equipo Laterne
      p.mt-2.text-gray-600 Usuarios con acceso al panel de administración.

      ul#container-users.mt-8.grid.gap-6(role='list' class='sm:grid-cols-2 lg:grid-cols-3')
        each user in Users
          li.panel.overflow-hidden.p-0(id='card-' + user.id)
            img.h-72.w-full.object-cover(src=user.imageUrl === 'avatar_profile_default.png' ? '/images/image_defect/avatar_profile_default.png' : '/images/images_profile/' + user.imageUrl alt='Foto de ' + user.name)
            .p-5
              h3.text-lg.font-bold= user.name
              p.mt-1.text-sm.text-gray-500= user.role === 1 ? 'Administrador' : 'Empleado'
              .mt-5.flex.items-center.justify-between.gap-3
                a.button-secondary(href='/user/view-edit-users/' + user.id) Editar
                button.delete-user.button-danger(type='button' data-user-id=user.id) Eliminar

block append scripts
  script(src='/js/admin/file-upload.js' defer)
  script(src='/js/admin/users.js' defer)
