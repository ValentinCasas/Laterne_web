extends layout_tailwind

block content
    title Editar categoría

    head
        script(src="/form_edit_category.js" defer)
        link(rel="stylesheet" href="/dist/category.css")
        script(src="/swiper.js" defer)

    body
        // Contenedor
        div(class="max-w-7xl mx-auto px-4 lg:px-8 py-6")
            // Grid: formulario (3/5) + preview (2/5)
            div(class="grid grid-cols-1 md:grid-cols-5 gap-6")

                // ============== FORM ==============
                form#form_edit_category(class="md:col-span-3 bg-white rounded-2xl shadow-sm p-5 space-y-6 overflow-hidden")
                    // Nombre
                    div(class="space-y-1")
                        label(for="name" class="block text-sm font-medium text-slate-700") NOMBRE
                        input#name(type="text" name="name" placeholder="Ej: Bebidas sin alcohol" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500")

                    // Descripción
                    div(class="space-y-1")
                        label(for="description" class="block text-sm font-medium text-slate-700") DESCRIPCIÓN
                        input#description(type="text" name="description" placeholder="Descripción breve" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500")

                    // Imagen (Swiper)
                    div
                        label(for="selectedImage" class="block text-sm font-medium text-slate-700 mb-2") IMAGEN
                        // contenedor swiper (clases existentes)
                        .swiper-container-categories.container-beer
                            .swiper-wrapper
                                each image in Images
                                    .swiper-slide.p-2
                                        // botón tile clickeable (conserva clase 'selectable-image' para tu JS)
                                        - const isSelected = image.name === Category.imageUrl
                                        button(
                                            type="button"
                                            class=`selectable-image w-full h-full rounded-xl border ${isSelected ? 'ring-2 ring-pink-500 border-pink-300' : 'border-slate-200'} bg-white hover:border-pink-300 transition focus:outline-none focus:ring-2 focus:ring-pink-500`
                                            data-name=image.name
                                            aria-pressed=isSelected
                                        )
                                            img(
                                                src=image.path
                                                alt=image.name
                                                class=`mx-auto max-h-24 w-auto p-4 ${isSelected ? 'selected' : ''}`
                                                data-name=image.name
                                            )
                                            span(class="sr-only")= image.name

                    // Hidden inputs
                    input#selectedImage(type="hidden" name="selectedImage" value=Category.imageUrl)
                    input(type="hidden" name="id" value=Category.id)

                    // Acción
                    div(class="flex items-center justify-end")
                        button(type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-lg shadow-sm transition mt-2") Editar

                // ============== PREVIEW ==============
                section#container-categories(class="md:col-span-2 h-full")
                    article(id=`card-${Category.id}` class="relative p-3 bg-white rounded-2xl shadow-sm border flex gap-3")
                        img#category-image(src=`/${Category.imageUrl}` alt=Category.name class="h-20 w-20 object-contain rounded-lg border bg-white")
                        div(class="flex flex-col justify-center w-full")
                            h3#category-name(class="text-lg font-semibold text-slate-900") #{Category.name}
                            p#category-description(class="text-slate-600 text-sm") #{Category.description}
