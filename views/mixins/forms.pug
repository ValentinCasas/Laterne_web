mixin field(labelText, name, type, value)
  .form-field
    label.form-label(for=name)= labelText
    input.form-input(id=name name=name type=type || 'text' value=value)&attributes(attributes)

mixin textareaField(labelText, name, value)
  .form-field
    label.form-label(for=name)= labelText
    textarea.form-input(id=name name=name rows='4')&attributes(attributes)= value

mixin fileUpload(labelText)
  .file-dropzone(data-file-dropzone)
    button.file-dropzone__trigger(type='button' data-file-trigger)
      svg.h-8.w-8(viewBox='0 0 24 24' fill='none' stroke='currentColor' aria-hidden='true')
        path(stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M12 16V4m0 0L8 8m4-4 4 4M5 15v4h14v-4')
      span= labelText || 'Seleccionar imagen'
    p.file-dropzone__hint(data-file-name) JPG, PNG o WebP
    input.sr-only#file(type='file' name='imageFile' accept='.jpg,.jpeg,.png,.webp')
