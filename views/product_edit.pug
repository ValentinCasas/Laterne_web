extends layout_tailwind

block content
    title Editar

    head
        script(src="/form_edit_product.js" defer)
        script(src="/drag_and_drop.js" defer)
        link(rel="stylesheet" href="/dist/drag_and_drop.css")

    body
        // Contenedor
        div(class="max-w-7xl mx-auto px-4 lg:px-8 py-6")
            // Grid 2 columnas
            div(class="grid grid-cols-1 gap-8 md:grid-cols-2")

                // ================== FORM ==================
                form#form_edit_product(class="h-full p-6 bg-white rounded-2xl shadow-sm overflow-hidden")
                    input(type="hidden" name="id" value=Product.id)

                    // Nombre
                    div(class="space-y-1")
                        label(for="name" class="block text-sm font-medium text-slate-700") NOMBRE
                        input#name(type="text" name="name" value=Product.name placeholder=Product.name class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500")

                    // Descripción
                    div(class="space-y-1 mt-6")
                        label(for="description" class="block text-sm font-medium text-slate-700") DESCRIPCIÓN
                        input#description(type="text" name="description" value=Product.description placeholder=Product.description class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500")

                    // Precio
                    div(class="space-y-1 mt-6")
                        label(for="price" class="block text-sm font-medium text-slate-700") PRECIO
                        input#price(type="number" name="price" min="0" step="0.01" inputmode="decimal" value=Product.price placeholder=Product.price class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500")

                    // Disponibilidad
                    div(class="space-y-1 mt-6")
                        label(for="availavility" class="block text-sm font-medium text-slate-700") DISPONIBILIDAD
                        select#availavility(name="availavility" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-pink-500")
                            option(value="agotado" selected=Product.availavility==='agotado') Agotado
                            option(value="disponible" selected=Product.availavility==='disponible') Disponible

                    // Categorías
                    h3(class="mt-8 mb-3 text-sm font-semibold text-slate-900") CATEGORÍAS
                    ul(class="grid md:grid-cols-1 w-full gap-4 h-60 overflow-auto mb-8")
                        each category in Categories
                            li
                                input.hidden.peer(
                                    type="checkbox"
                                    name="categoryIds"
                                    id=`category-${category.id}`
                                    value=category.id
                                    checked=ProductCategory.some(pc => pc.categoryId === category.id)
                                )
                                label(for=`category-${category.id}` class="inline-flex items-center justify-between w-full p-5 text-slate-600 bg-white border-2 border-slate-200 rounded-lg cursor-pointer hover:text-black hover:bg-blue-50 peer-checked:bg-blue-600 peer-checked:text-white")
                                    div(class="grid grid-cols-2 gap-3 items-center")
                                        div
                                            img(src="/" + category.imageUrl class="h-12")
                                        div
                                            div(class="w-full text-base font-semibold") #{category.name}
                                            div(class="w-full text-xs opacity-80") #{category.description}

                    // Upload (drag & drop)
                    div(class="mb-6")
                        .container
                            .header
                                svg(viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 mx-auto")
                                    path(d="M7 10V9C7 6.23858 9.23858 4 12 4C14.7614 4 17 6.23858 17 9V10C19.2091 10 21 11.7909 21 14C21 15.4806 20.1956 16.8084 19 17.5M7 10C4.79086 10 3 11.7909 3 14C3 15.4806 3.8044 16.8084 5 17.5M7 10C7.43285 10 7.84965 10.0688 8.24006 10.1959" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round")
                                p(class="text-center text-sm mt-2") imagen
                        // conectar el label con el input real (#file)
                        label.footer(for="file" class="mt-2 rounded-lg bg-slate-50 px-3 py-2 flex items-center justify-between gap-2 cursor-pointer")
                            span(class="text-sm text-slate-600 flex-1") Nada seleccionado
                            svg(viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="#000")
                                path(d="M15.331 6H8.5v20h15V14.154h-8.169")
                                path(d="M18.153 6h-.009v5.342H23.5v-.002")
                            svg(viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6")
                                path(d="M5.16565 10.1534C5.07629 8.99181 5.99473 8 7.15975 8H16.8402C18.0053 8 18.9237 8.9918 18.8344 10.1534L18.142 19.1534C18.0619 20.1954 17.193 21 16.1479 21H7.85206C6.80699 21 5.93811 20.1954 5.85795 19.1534L5.16565 10.1534Z" stroke="#000" stroke-width="2")
                                path(d="M19.5 5H4.5" stroke="#000" stroke-width="2" stroke-linecap="round")
                                path(d="M10 3C10 2.44772 10.4477 2 11 2H13C13.5523 2 14 2.44772 14 3V5H10V3Z" stroke="#000" stroke-width="2")
                    input#file(type="file" name="imageFile" accept=".jpg, .jpeg, .png, .webp")

                    // Botón
                    div(class="flex items-center justify-end")
                        button(type="submit" class="bg-blue-600 hover:bg-blue-700 mt-4 text-white font-semibold px-4 py-2 rounded-lg") Editar

                // ================== PREVIEW ==================
                section#container-products(class="h-screen overflow-auto px-3 xl:px-6 lg:px-6")
                    div(id=`card-${Product.id}` class="grid grid-cols-1 card relative overflow-hidden mb-10 border bg-white shadow-xl rounded-3xl")
                        img#product-image(src=`/${Product.imageUrl}` alt=Product.name class="w-full h-48 object-contain rounded-t-lg")
                        div(class="w-full p-4")
                            h3#product-name(class="text-lg font-bold mb-2 ml-2") #{Product.name}
                            details(class="border rounded-md overflow-hidden shadow-md bg-white my-2")
                                summary(class="bg-gray-200 p-4 cursor-pointer") Descripción del Producto
                                div(class="p-4")
                                    p#product-description(class="text-gray-600") #{Product.description}
                            p#product-availavility(class="text-gray-600 ml-2") #{Product.availavility}
                            p#product-price(class="text-gray-600 ml-2") $ #{Product.price}

                            div(class="mb-2 p-2")
                                label(for="productCategories" class="text-gray-700 font-bold") CATEGORÍAS
                                div#product-categories(class="flex flex-wrap my-2")
                                    each pc in ProductCategory
                                        div(key=pc.id class="mr-4 mb-2 p-2 bg-gray-200 rounded-md")
                                            span(class="text-blue-500 font-semibold") #{pc.Category.name}
