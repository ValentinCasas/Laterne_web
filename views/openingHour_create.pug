extends layout_tailwind

block content
    title Horarios

    head
        script(src="/form_create_openingHour.js" defer)
        link(rel="stylesheet" href="/dist/openingHour.css")

    body
        div(class="max-w-7xl mx-auto px-4 lg:px-8 py-8")
            .bg-white.rounded-2xl.shadow-sm.p-5
                h1.text-xl.font-semibold.text-slate-800.mb-6 Horarios de atención

                form#form-openingHour
                    // Encabezado (solo en md+)
                    div(class="hidden md:grid grid-cols-5 gap-3 text-xs font-semibold text-slate-700 mb-3")
                        span Día
                        span Mañana apertura
                        span Mañana cierre
                        span Noche apertura
                        span Noche cierre

                    // ---- 7 filas fijas: LUN a DOM ----
                    - var days  = ['LUN','MAR','MIE','JUE','VIE','SAB','DOM'];
                    - var keys  = ['lun','mar','mier','jue','vie','sab','dom'];
                    - for (var i = 0; i < 7; i++) {
                    -   var oh     = (typeof OpeningHour !== 'undefined' && OpeningHour[i]) ? OpeningHour[i] : null;
                    -   var prefix = keys[i];
                    -   var ms     = (oh && oh.morningStartTime) ? oh.morningStartTime : '';
                    -   var me     = (oh && oh.morningEndTime)   ? oh.morningEndTime   : '';
                    -   var es     = (oh && oh.eveningStartTime) ? oh.eveningStartTime : '';
                    -   var ee     = (oh && oh.eveningEndTime)   ? oh.eveningEndTime   : '';

                        div(class="grid grid-cols-1 md:grid-cols-5 gap-3 items-center mb-3 p-3 rounded-xl border border-slate-200")
                            // Día + eliminar
                            div(class="flex items-center justify-between")
                                span(class="text-sm font-semibold text-slate-800")= days[i]
                                if (oh && oh.id)
                                    a.delete-link(
                                        href='/openingHour/delete-hour/' + oh.id
                                        data-id=oh.id
                                        class="text-rose-600 hover:text-rose-700 text-xs font-medium"
                                    ) Eliminar
                                else
                                    span(class="text-slate-300 text-xs font-medium cursor-not-allowed") Eliminar

                            // Mañana apertura
                            div
                                label(for=prefix + 'MorningStartTime' class="block md:hidden text-xs text-slate-500 mb-1") Mañana apertura
                                input(
                                    type='time'
                                    name=prefix + 'MorningStartTime'
                                    value=ms
                                    class='w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600'
                                )

                            // Mañana cierre
                            div
                                label(for=prefix + 'MorningEndTime' class="block md:hidden text-xs text-slate-500 mb-1") Mañana cierre
                                input(
                                    type='time'
                                    name=prefix + 'MorningEndTime'
                                    value=me
                                    class='w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600'
                                )

                            // Noche apertura
                            div
                                label(for=prefix + 'EveningStartTime' class="block md:hidden text-xs text-slate-500 mb-1") Noche apertura
                                input(
                                    type='time'
                                    name=prefix + 'EveningStartTime'
                                    value=es
                                    class='w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600'
                                )

                            // Noche cierre
                            div
                                label(for=prefix + 'EveningEndTime' class="block md:hidden text-xs text-slate-500 mb-1") Noche cierre
                                input(
                                    type='time'
                                    name=prefix + 'EveningEndTime'
                                    value=ee
                                    class='w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600'
                                )
                    - }

                    .flex.justify-end.mt-6
                        button(
                            type='submit'
                            class='bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-5 py-2.5 rounded-lg shadow-sm transition'
                        ) Guardar cambios
