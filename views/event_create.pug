extends layout_tailwind

block content
    title Eventos

    head
        script(src="/form_create_event.js" defer)
        link(rel="stylesheet" href="/dist/event.css")
        script(src="/drag_and_drop.js" defer)
        link(rel="stylesheet" href="/dist/drag_and_drop.css")

    body
        // Contenedor general
        div(class="max-w-7xl mx-auto px-4 lg:px-8 py-6")
            // Grid responsive: formulario (izq) + listado (der)
            div(class="grid grid-cols-1 lg:grid-cols-5 gap-6")

                // ===========================
                // FORMULARIO (col 2/5)
                // ===========================
                form#form_event(class="lg:col-span-2 bg-white rounded-2xl shadow-sm p-5 space-y-5")

                    // Nombre
                    div(class="space-y-1")
                        label(for="name" class="block text-sm font-medium text-slate-700") NOMBRE
                        input#name(type="text" name="name" placeholder="Ej: Show YSY" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500")

                    // Descripción
                    div(class="space-y-1")
                        label(for="description" class="block text-sm font-medium text-slate-700") DESCRIPCION
                        input#description(type="text" name="description" placeholder="Descripción breve" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500")

                    // Fecha
                    div(class="space-y-1")
                        label(for="date" class="block text-sm font-medium text-slate-700") FECHA
                        input#date(type="date" name="date" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500")

                    // Hora
                    div(class="space-y-1")
                        label(for="time" class="block text-sm font-medium text-slate-700") HORA
                        input#time(type="time" name="time" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500")

                    // Dirección
                    div(class="space-y-1")
                        label(for="location" class="block text-sm font-medium text-slate-700") DIRECCION
                        input#location(type="text" name="location" placeholder="Ej: La Punta / San Luis" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500")

                    // Upload (mantiene tus clases/ids para JS)
                    div(class="space-y-2")
                        span(class="block text-sm font-medium text-slate-700") IMAGEN
                        .container
                            .header(class="rounded-xl border-2 border-dashed border-sky-300 bg-sky-50/40 p-6 flex flex-col items-center justify-center gap-3 text-slate-600")
                                svg(viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-20 h-20")
                                    path(d="M7 10V9C7 6.23858 9.23858 4 12 4C14.7614 4 17 6.23858 17 9V10C19.2091 10 21 11.7909 21 14C21 15.4806 20.1956 16.8084 19 17.5M7 10C4.79086 10 3 11.7909 3 14C3 15.4806 3.8044 16.8084 5 17.5M7 10C7.43285 10 7.84965 10.0688 8.24006 10.1959" stroke="#0f172a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round")
                                p(class="text-sm") Arrastrá una imagen o hacé click abajo
                            // ojo: el label ahora referencia al input real (id="file")
                            label.footer(for="file" class="rounded-lg bg-slate-50 px-3 py-2 flex items-center justify-between gap-2 cursor-pointer")
                                span(class="text-sm text-slate-600 flex-1 text-center") Nada seleccionado
                                svg(fill="#000000" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6")
                                    path(d="M15.331 6H8.5v20h15V14.154h-8.169")
                                    path(d="M18.153 6h-.009v5.342H23.5v-.002")
                        input#file(type="file" name="imageFile" accept=".jpg,.jpeg,.png,.webp" hidden)

                    div(class="flex items-center justify-end pt-2")
                        button(type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-lg shadow-sm transition") Crear

                // ===========================
                // LISTADO DE EVENTOS (col 3/5)
                // ===========================
                section#container-events(class="lg:col-span-3 space-y-5")
                    // Barra de búsqueda sticky
                    div(class="sticky top-0 z-20 bg-white/90 backdrop-blur rounded-2xl shadow-sm p-4")
                        input#search-input(type="text" placeholder="Buscar eventos..." class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-600")

                    // Cards
                    each event in Events
                        article(id=`card-${event.id}` class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden")
                            // grid de card: imagen + contenido
                            div(class="grid grid-cols-[110px_1fr] md:grid-cols-[160px_1fr] gap-4 p-4")
                                // Imagen
                                if event.imageUrl
                                    // contenedor con recorte consistente
                                    div(class="w-full h-[88px] md:h-[120px] rounded-lg overflow-hidden bg-slate-100")
                                        img(src=`/${event.imageUrl}` alt=event.name class="w-full h-full object-cover")
                                else
                                    div(class="w-full h-[88px] md:h-[120px] rounded-lg bg-slate-50 flex items-center justify-center text-slate-400 text-xs")
                                        | sin foto

                                // Contenido
                                div(class="flex flex-col gap-1")
                                    h3(class="text-base md:text-lg font-bold text-slate-800") #{event.name}
                                    if event.description
                                        p(class="text-slate-600 text-sm") #{event.description}

                                    // Fecha
                                    if event.date
                                        - const __dateObj = new Date(event.date);
                                        - const __dateStr = __dateObj.toLocaleDateString('es-AR', { timeZone: 'UTC' });
                                        p(class="text-slate-600 text-sm") #{__dateStr}

                                    // Hora
                                    if event.time
                                        - const __parts = event.time.split(":");
                                        - const __t = new Date();
                                        - __t.setHours(Number(__parts[0])); __t.setMinutes(Number(__parts[1]));
                                        p(class="text-slate-600 text-sm") #{__t.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' })}

                                    if event.location
                                        p(class="text-slate-600 text-sm") #{event.location}

                            // Footer acciones (sin absolute -> no se pisa en mobile)
                            div(class="grid grid-cols-2 divide-x border-t border-slate-200")
                                a(href=`/event/view-edit-event/${event.id}` class="text-center py-3 text-slate-700 hover:bg-slate-50 font-medium rounded-bl-2xl") Editar
                                a(href=`/event/delete-event/${event.id}` data-event-id=event.id class="delete-event text-center py-3 text-rose-600 hover:bg-rose-50 font-medium rounded-br-2xl") Eliminar
