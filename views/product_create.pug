extends layout_tailwind

block content
    title Productos

    head
        script(src="/form_create_product.js" defer)
        link(rel="stylesheet" href="/dist/product.css")
        script(src="/drag_and_drop.js" defer)
        script(src="/product_create.js" defer)
        link(rel="stylesheet" href="/dist/drag_and_drop.css")
        style.
            .check {
                cursor: pointer; position: relative; margin: auto; width: 18px; height: 18px;
                -webkit-tap-highlight-color: transparent; transform: translate3d(0,0,0);
            }
            .check:before {
                content: ""; position: absolute; top: -15px; left: -15px; width: 48px; height: 48px; border-radius: 50%;
                background: rgba(34,50,84,.03); opacity: 0; transition: opacity .2s ease;
            }
            .check svg {
                position: relative; z-index: 1; fill: none; stroke-linecap: round; stroke-linejoin: round; stroke: #c8ccd4;
                stroke-width: 1.5; transform: translate3d(0,0,0); transition: all .2s ease;
            }
            .check svg path { stroke-dasharray: 60; stroke-dashoffset: 0; }
            .check svg polyline { stroke-dasharray: 22; stroke-dashoffset: 66; }
            .check:hover:before { opacity: 1; }
            .check:hover svg { stroke: var(--accent-color, #a3e583); }
            #cbx2:checked + .check svg { stroke: var(--accent-color, #a3e583); }
            #cbx2:checked + .check svg path { stroke-dashoffset: 60; transition: all .3s linear; }
            #cbx2:checked + .check svg polyline { stroke-dashoffset: 42; transition: all .2s linear; transition-delay: .15s; }
            .each-product-checkbox:checked + .check svg { stroke: var(--accent-color, #a3e583); }
            .each-product-checkbox:checked + .check svg path { stroke-dashoffset: 60; transition: all .3s linear; }
            .each-product-checkbox:checked + .check svg polyline { stroke-dashoffset: 42; transition: all .2s linear; transition-delay: .15s; }

    body
        // Contenedor general
        div(class="max-w-7xl mx-auto px-4 lg:px-8 py-6")
            // Grid: formulario (2/5) + listado (3/5)
            div(class="grid grid-cols-1 lg:grid-cols-5 gap-6")

                // ================== FORM ==================
                form#form_product(class="lg:col-span-2 bg-white rounded-2xl shadow-sm p-5 space-y-6")

                    // Nombre
                    div(class="space-y-1")
                        label(for="name" class="block text-sm font-medium text-slate-700") NOMBRE
                        input#name(type="text" name="name" placeholder="Ej: Cerveza rubia" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500")

                    // Descripción
                    div(class="space-y-1")
                        label(for="description" class="block text-sm font-medium text-slate-700") DESCRIPCION
                        input#description(type="text" name="description" placeholder="Descripción breve" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500")

                    // Precio
                    div(class="space-y-1")
                        label(for="price" class="block text-sm font-medium text-slate-700") PRECIO
                        input#price(type="number" name="price" min="0" step="0.01" inputmode="decimal" placeholder="0.00" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500")

                    // Disponibilidad
                    div(class="space-y-1")
                        label(for="availavility" class="block text-sm font-medium text-slate-700") DISPONIBILIDAD
                        select#availavility(name="availavility" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-pink-500")
                            option(value="agotado") Agotado
                            option(value="disponible") Disponible

                    // Categoría (si hay)
                    if Categories.length > 0
                        div(class="space-y-1")
                            label(for="categoryId" class="block text-sm font-medium text-slate-700") CATEGORIAS
                            select(name="categoryId" id="categoryId" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-pink-500")
                                each category in Categories
                                    option(value=category.id)= category.name
                    else
                        div

                    // Upload (mantiene tus clases/ids para drag_and_drop.js)
                    div(class="space-y-2")
                        span(class="block text-sm font-medium text-slate-700") IMAGEN
                        .container
                            .header(class="rounded-xl border-2 border-dashed border-sky-300 bg-sky-50/40 p-6 flex flex-col items-center justify-center gap-3 text-slate-600")
                                svg(viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-20 h-20")
                                    path(d="M7 10V9C7 6.23858 9.23858 4 12 4C14.7614 4 17 6.23858 17 9V10C19.2091 10 21 11.7909 21 14C21 15.4806 20.1956 16.8084 19 17.5M7 10C4.79086 10 3 11.7909 3 14C3 15.4806 3.8044 16.8084 5 17.5M7 10C7.43285 10 7.84965 10.0688 8.24006 10.1959" stroke="#0f172a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round")
                                p(class="text-sm") Arrastrá una imagen o hacé click abajo
                        // el label debe apuntar al input real #file
                        label.footer(for="file" class="rounded-lg bg-slate-50 px-3 py-2 flex items-center justify-between gap-2 cursor-pointer")
                            span(class="text-sm text-slate-600 flex-1 text-center") Nada seleccionado
                            svg(fill="#000000" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6")
                                path(d="M15.331 6H8.5v20h15V14.154h-8.169")
                                path(d="M18.153 6h-.009v5.342H23.5v-.002")
                        input#file(type="file" name="imageFile" accept=".jpg,.jpeg,.png,.webp" hidden)

                    div(class="flex items-center justify-end pt-2")
                        button(type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-lg shadow-sm transition") Crear

                // ================== LISTADO ==================
                section#container-products(class="lg:col-span-3 space-y-6")
                    // Barra superior sticky: búsqueda + % masivo + seleccionar todo
                    div(class="grid grid-cols-1 gap-3 sticky top-0 z-10 bg-white/90 backdrop-blur p-4 rounded-2xl shadow-sm")
                        // buscador
                        input#search-input(type="text" placeholder="Buscar producos..." class="px-3 py-2.5 border w-full border-slate-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-slate-600")

                        // acciones masivas
                        div(class="grid grid-cols-1 sm:grid-cols-2 gap-2 w-full")
                            form#form-percentaje(class="relative text-gray-600 flex items-center gap-2")
                                div(class="absolute inset-y-0 left-3 my-auto h-6 flex items-center border-r pr-2")
                                    select(name="operation" class="text-sm outline-none rounded-md h-full")
                                        option(value="sum") SUM
                                        option(value="res") RES
                                input(type="number" name="percentage" placeholder="%" class="text-center py-2 appearance-none bg-white outline-none border shadow-sm rounded-lg pl-[4.5rem] focus:border-slate-600 w-full")
                                button(type="submit" class="border rounded-lg py-2 px-3") enviar
                            button#btn-select-products(type="button" class="py-2 border rounded-lg") Seleccionar Todo

                    // Cards
                    each product in Products
                        article(id=`card-${product.id}` class="card relative overflow-hidden flex border bg-white shadow-sm rounded-2xl")
                            // Checkbox arriba a la derecha (mantiene tus clases y SVG)
                            div(class="absolute top-2 right-3")
                                input(type="checkbox" id=`cbx-${product.id}` name=`cbx-${product.id}` class="each-product-checkbox" style="display:none;")
                                label.check(for=`cbx-${product.id}`)
                                    svg(width="18px" height="18px" viewbox="0 0 18 18")
                                        path(d="M 1 9 L 1 9 c 0 -5 3 -8 8 -8 L 9 1 C 14 1 17 5 17 9 L 17 9 c 0 4 -4 8 -8 8 L 9 17 C 5 17 1 14 1 9 L 1 9 Z")
                                        polyline(points="1 9 7 14 15 4")

                            // Imagen
                            if product.imageUrl === "product_default.png"
                                img(src="/", alt=product.name, class="h-0")
                            else
                                img(src=`/${product.imageUrl}` alt=product.name class="w-1/3 max-w-[220px] h-40 object-contain p-4 hidden sm:block")

                            // Contenido
                            div(class="p-4 flex flex-col gap-2 w-full")
                                h3(class="text-base font-semibold text-slate-800") #{product.name}

                                // Descripción colapsable
                                details(class="border rounded-md overflow-hidden bg-white")
                                    summary(class="bg-gray-100 px-3 py-2 cursor-pointer text-sm") Descripción del Producto
                                    div(class="p-3")
                                        p(class="text-gray-600 text-sm") #{product.description}

                                p(class="text-gray-600 text-sm") #{product.availavility}
                                // Mantengo tu id #price-element (añado clase para estilo, por si luego querés usarla)
                                p#price-element(class="text-gray-900 font-medium mb-2 price-element") $ #{product.price}

                                // Footer de acciones (sin absolute → mejor en mobile)
                                div(class="grid grid-cols-2 divide-x border-t border-slate-200 mt-2")
                                    a(href=`/product/view-edit-product/${product.id}` class="text-center py-2 text-slate-700 hover:bg-slate-50 font-medium") Editar
                                    a(href=`/product/delete-product/${product.id}` data-product-id=product.id class="delete-product text-center py-2 text-rose-600 hover:bg-rose-50 font-medium") Eliminar
