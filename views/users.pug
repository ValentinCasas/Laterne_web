extends layout_tailwind

block content
    title Usuarios

    head
        script(src="/users_fetch.js" defer)
        script(src="/drag_and_drop.js" defer)
        link(rel="stylesheet" href="/dist/drag_and_drop.css")

    body
        // Contenedor principal
        div(class="max-w-7xl mx-auto px-4 lg:px-8 py-6")
            // Grid: formulario (2/5) + listado (3/5)
            div(class="grid grid-cols-1 lg:grid-cols-5 gap-6")

                // ===========================
                // FORMULARIO
                // ===========================
                form#form_user(class="lg:col-span-2 bg-white rounded-2xl shadow-sm p-5 space-y-6")

                    // Nombre
                    div(class="space-y-1")
                        label(for="name" class="block text-sm font-medium text-slate-700") NOMBRE
                        input#name(type="text" name="name" placeholder="Ej: Juan Pérez" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500")

                    // Email
                    div(class="space-y-1")
                        label(for="email" class="block text-sm font-medium text-slate-700") EMAIL
                        input#email(type="email" name="email" placeholder="usuario@dominio.com" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500")

                    // Contraseña
                    div(class="space-y-1")
                        label(for="password" class="block text-sm font-medium text-slate-700") CONTRASEÑA
                        input#password(type="password" name="password" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500")

                    // Rol
                    div(class="space-y-1")
                        label(for="role" class="block text-sm font-medium text-slate-700") ROL
                        select#role(name="role" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-pink-500")
                            option(value="1") Administrador
                            option(value="2") Empleado

                    // Upload (mantiene tus clases/ids para drag_and_drop.js)
                    div(class="space-y-2")
                        span(class="block text-sm font-medium text-slate-700") IMAGEN
                        .container
                            .header(class="rounded-xl border-2 border-dashed border-sky-300 bg-sky-50/40 p-6 flex flex-col items-center justify-center gap-3 text-slate-600")
                                svg(viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-20 h-20")
                                    path(d="M7 10V9C7 6.23858 9.23858 4 12 4C14.7614 4 17 6.23858 17 9V10C19.2091 10 21 11.7909 21 14C21 15.4806 20.1956 16.8084 19 17.5M7 10C4.79086 10 3 11.7909 3 14C3 15.4806 3.8044 16.8084 5 17.5M7 10C7.43285 10 7.84965 10.0688 8.24006 10.1959" stroke="#0f172a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round")
                                p(class="text-sm") Arrastrá una imagen o hacé click abajo
                        // Nota: el label ahora referencia al input real (id="file")
                        label.footer(for="file" class="rounded-lg bg-slate-50 px-3 py-2 flex items-center justify-between gap-2 cursor-pointer")
                            span(class="text-sm text-slate-600 flex-1 text-center") Nada seleccionado
                            svg(fill="#000000" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6")
                                path(d="M15.331 6H8.5v20h15V14.154h-8.169")
                                path(d="M18.153 6h-.009v5.342H23.5v-.002")
                        input#file(type="file" name="imageFile" accept=".jpg,.jpeg,.png,.webp" hidden)

                    div(class="flex items-center justify-end pt-2")
                        button(type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-lg shadow-sm transition") Crear

                // ===========================
                // LISTADO / TEAM
                // ===========================
                section(class="lg:col-span-3")
                    div(class="bg-white rounded-2xl shadow-sm p-5")
                        header(class="space-y-1 mb-5")
                            h2(class="text-2xl font-bold tracking-tight") Team Laterne
                            p(class="text-slate-500 text-sm") Vista específicamente para administradores.

                        // Grid de usuarios (conserva #container-users)
                        ul#container-users(role="list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6")
                            each user in Users
                                li(id=`card-${user.id}` class="rounded-2xl border border-slate-200 shadow-sm overflow-hidden flex flex-col")
                                    // Imagen
                                    div(class="w-full h-64 bg-slate-100 overflow-hidden")
                                        img(src=`${user.imageUrl == "avatar_profile_default.png" ? "/avatar_profile_default.png" : "/" + user.imageUrl}` alt=user.name class="w-full h-full object-cover")
                                    // Contenido
                                    div(class="p-4 space-y-1")
                                        h3(class="text-lg font-semibold text-slate-800")= user.name
                                        p(class="text-sm text-slate-600")= (user.role == 1 ? "Admin" : "Empleado")
                                    // Acciones (sin absolute → mejor en mobile)
                                    div(class="grid grid-cols-2 divide-x border-t border-slate-200 mt-auto")
                                        a(href=`/user/view-edit-users/${user.id}` class="text-center py-3 text-slate-700 hover:bg-slate-50 font-medium") EDITAR
                                        a(href=`/auth/delete-user/${user.id}` data-user-id=user.id class="delete-user text-center py-3 text-rose-600 hover:bg-rose-50 font-medium") ELIMINAR
