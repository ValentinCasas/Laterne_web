extends layout_tailwind

block content
    title Categorias

    head
        script(src="/form_create_category.js" defer)
        link(rel="stylesheet" href="/dist/category.css")
        script(src="/swiper.js" defer)

    body
        // Contenedor general
        div(class="max-w-7xl mx-auto px-4 lg:px-8 py-6")
            // Grid: formulario (2/5) + listado (3/5)
            div(class="grid grid-cols-1 lg:grid-cols-5 gap-6")

                // =============== FORM ===============
                form#form_category(class="lg:col-span-2 bg-white rounded-2xl shadow-sm p-5 space-y-5")

                    // Nombre
                    div(class="space-y-1")
                        label(for="name" class="block text-sm font-medium text-slate-700") NOMBRE
                        input#name(type="text" name="name" placeholder="Ej: Bebidas" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500")

                    // Descripción
                    div(class="space-y-1")
                        label(for="description" class="block text-sm font-medium text-slate-700") DESCRIPCION
                        input#description(type="text" name="description" placeholder="Descripción breve" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500")

                    // Selector de imagen (Swiper)
                    div(class="space-y-2")
                        label(class="block text-sm font-medium text-slate-700") IMAGEN (elegí una)
                        div(class="w-full mb-2 max-h-[220px] overflow-hidden")
                            .swiper-container-categories.container-beer
                                .swiper-wrapper
                                    each image in Images
                                        // Hacé clic en toda la tarjeta
                                        .swiper-slide.py-0.flex.items-center.justify-center.border.rounded-md.cursor-pointer(tabindex="0" data-name=image.name)
                                            img(src=image.path, alt=image.name, class="selectable-image max-h-24 w-auto p-4", data-name=image.name)

                        input(type="hidden" name="selectedImage" id="selectedImage")

                    // Acción
                    div(class="flex items-center justify-end pt-2")
                        button(type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-lg shadow-sm transition") Crear

                // =============== LISTADO ===============
                section#container-categories(class="lg:col-span-3 space-y-5")
                    // Buscador sticky
                    div(class="sticky top-0 z-10 bg-white/90 backdrop-blur rounded-2xl shadow-sm p-4")
                        input#search-input(type="text" placeholder="Buscar categorias..." class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-600")

                    // Grid de categorías
                    div(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5")
                        each category in Categories
                            article(id=`card-${category.id}` class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden flex flex-col")
                                // Imagen
                                if category.imageUrl
                                    div(class="w-full h-40 bg-slate-50 overflow-hidden")
                                        img(src=`/${category.imageUrl}` alt=category.name class="w-full h-full object-contain p-4")
                                else
                                    div(class="w-full h-40 bg-slate-50 flex items-center justify-center text-slate-400 text-sm")
                                        | Sin imagen

                                // Contenido
                                div(class="p-4 space-y-1 flex-1")
                                    h3(class="text-base font-semibold text-slate-800") #{category.name}
                                    if category.description
                                        p(class="text-slate-600 text-sm") #{category.description}

                                // Footer de acciones (sin absolute → mejor en mobile)
                                div(class="grid grid-cols-2 divide-x border-t border-slate-200")
                                    a(href=`/category/view-edit-category/${category.id}` class="text-center py-3 text-slate-700 hover:bg-slate-50 font-medium") Editar
                                    a(href=`/category/delete-category/${category.id}` data-category-id=category.id class="delete-category text-center py-3 text-rose-600 hover:bg-rose-50 font-medium") Eliminar
