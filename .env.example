# ─────────────────────────────────────────────────────────────────────────────
# MenuClick · Variables de entorno
# Copiar como `.env` para desarrollo. En producción se inyectan vía el
# orquestador (Docker secrets, panel del VPS, etc.), nunca en el repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# Base de datos MySQL (obligatoria en todos los entornos).
# Se pueden añadir parámetros de pool; si no, se aplican los valores de
# PRISMA_CONNECTION_LIMIT y PRISMA_POOL_TIMEOUT.
DATABASE_URL="mysql://root:password@localhost:3306/laterne"

# Secreto de firma de sesiones. OBLIGATORIO en producción; la app no arranca sin él.
AUTH_SECRET="generar-un-secreto-largo-y-aleatorio"

# URL pública del sitio (se usa para links canónicos).
NEXT_PUBLIC_SITE_URL="https://menu-click.app"

# Dominio base sin protocolo usado en producción. OBLIGATORIO en producción.
ROOT_DOMAIN="menu-click.app"

# Alias opcional legacy para development. Las rutas canónicas normales usan localhost.
DEV_ROOT_DOMAIN="lvh.me"
DEV_PORT="3000"

# Subdominio del panel administrativo de los negocios.
APP_SUBDOMAIN="app"
# Subdominio del panel de control de la plataforma.
PLATFORM_SUBDOMAIN="platform"
# Fallback legacy para URLs antiguas locales (/carta, /admin, etc.).
DEV_TENANT_SLUG="laterne"

# ─────────────────────────────────────────────────────────────────────────────
# Proxy / HTTPS
# ─────────────────────────────────────────────────────────────────────────────
# Poner en "true" SOLO cuando la app está detrás de un proxy confiable
# (Nginx, Traefik, Cloudflare, load balancer) que reescribe X-Forwarded-*.
# Sin esto, los headers reenviados se ignoran (los puede falsificar Internet).
# En desarrollo local dejalo vacío.
TRUST_PROXY=""

# En producción la app asume HTTPS: las cookies de sesión se marcan Secure
# automáticamente (NODE_ENV=production). No requiere variable adicional.

# ─────────────────────────────────────────────────────────────────────────────
# Storage (uploads de runtime)
# ─────────────────────────────────────────────────────────────────────────────
# "local" escribe en public/ (desarrollo / 1 instancia con disco persistente).
# "s3" usa un bucket S3-compatible (AWS, Cloudflare R2, DigitalOcean Spaces, MinIO).
STORAGE_DRIVER="local"

# Variables requeridas cuando STORAGE_DRIVER=s3:
# S3_BUCKET="menuclick-media"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="us-east-1"
# Para proveedores S3-compatibles (MinIO, Spaces, R2) apuntar el endpoint.
# S3_ENDPOINT="https://minio.example.com"
# S3_PATH_STYLE_DISABLED=""   # dejar vacío → path-style; "true" para virtual-host

# ─────────────────────────────────────────────────────────────────────────────
# Base de datos · pool (multi-instancia)
# ─────────────────────────────────────────────────────────────────────────────
# Conexiones por instancia. Cálculo: réplicas × connection_limit <= max_connections.
PRISMA_CONNECTION_LIMIT="10"
PRISMA_POOL_TIMEOUT="10"

# ─────────────────────────────────────────────────────────────────────────────
# Multi-instancia / despliegue
# ─────────────────────────────────────────────────────────────────────────────
# Identificador de despliegue para protección contra version skew (opcional).
# Todas las réplicas del mismo despliegue deben usar el mismo valor.
DEPLOYMENT_VERSION=""

# Clave de cifrado de Server Actions de Next.js. En multi-instancia TODAS las
# réplicas deben compartirla (base64 de 16/24/32 bytes).
# Se define en el entorno de BUILD y runtime; ejemplo de generación:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# Email / integraciones opcionales
# ─────────────────────────────────────────────────────────────────────────────
# Recuperación de acceso mediante un webhook HTTPS compatible con el proveedor elegido.
EMAIL_WEBHOOK_URL=""
EMAIL_API_KEY=""

# Conectores opcionales. Las credenciales nunca se guardan en MySQL ni se exponen al navegador.
MERCADOPAGO_ACCESS_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""
VAPID_PRIVATE_KEY=""
STORAGE_SECRET_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# DOCX -> PDF para comprobantes (módulo de facturación, no se toca aquí)
# ─────────────────────────────────────────────────────────────────────────────
# Opción A: servicio remoto que reciba el DOCX y devuelva el PDF.
DOCUMENT_CONVERTER_URL=""
DOCUMENT_CONVERTER_TOKEN=""
# Opción B: LibreOffice instalado en el servidor (autodetección en rutas típicas).
LIBREOFFICE_PATH=""
DOCUMENT_CONVERTER_COMMAND=""