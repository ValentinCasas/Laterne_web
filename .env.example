DATABASE_URL="mysql://root:password@localhost:3306/laterne"
AUTH_SECRET="generar-un-secreto-largo-y-aleatorio"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Dominio base sin protocolo. Permite resolver subdominios por negocio en producción.
ROOT_DOMAIN="laterne.app"
# Subdominio del panel administrativo de los negocios (app.laterne.app).
APP_SUBDOMAIN="app"
# Subdominio del panel de control de la plataforma (platform.laterne.app).
PLATFORM_SUBDOMAIN="platform"
# Negocio de demostración usado como respaldo en desarrollo local (localhost).
DEV_TENANT_SLUG="laterne"

# Recuperación de acceso mediante un webhook HTTPS compatible con el proveedor elegido.
EMAIL_WEBHOOK_URL=""
EMAIL_API_KEY=""

# Conectores opcionales. Las credenciales nunca se guardan en MySQL ni se exponen al navegador.
MERCADOPAGO_ACCESS_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""
VAPID_PRIVATE_KEY=""
STORAGE_SECRET_KEY=""
